// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
// MZ SDP — Standard Deviation Projection as taught by Milad Zaker (MZ_ICT mentorship 1403)
// Recommended chart: FOREXCOM:EURUSD, 15-minute timeframe. All times New York.

//@version=6
indicator("MZ SDP — Standard Deviation Projection (Milad Zaker)", shorttitle = "MZ SDP", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 300, max_bars_back = 2000)
plot(na, "MZ SDP", display = display.none)  // keeps the script valid as an indicator

const string TZ = "America/New_York"

string iMode = input.string("Balanced", "Signal mode", options = ["Strict (notes)", "Balanced"], tooltip = "Strict: every filter of the notes rejects the setup (few signals).")
string iMssSw = input.string("Short-term swing (≈ LTF ITH/ITL)", "MSS must break", options = ["Short-term swing (≈ LTF ITH/ITL)", "ITH/ITL of this timeframe"], tooltip = "The notes take the 2022 entry on 1-5m inside the zone, where the MSS breaks an ITH/ITL of that low timeframe.")
bool   MSS_SHORT = iMssSw == "Short-term swing (≈ LTF ITH/ITL)"
string iProfile = input.string("Custom (settings below)", "Profile", options = ["Custom (settings below)", "More signals"], tooltip = "Custom with the defaults = your rules (10 weeks: EURUSD 51 signals / 20 filled, 65% win, +26.5R; GBPUSD 48 / 24, 33%, +2.0R).")
bool   BEST = iProfile == "More signals"

const string G_COND = "🔧 Signal conditions — untick one to get more signals"
bool   iUseWin  = input.bool(true, "Killzones / silver bullets only (off = any time)", group = G_COND)
bool   iMO      = input.bool(true, "Buy below / sell above NY Open", group = G_COND)
string iNoFvg = input.string("Market", "No FVG in the displacement leg → enter at", options = ["Off", "Market", "MSS level", "Equilibrium"], group = G_COND, tooltip = "User rule: always look for the FVG, but do not block the setup without one.")
string iHtfFilter = input.string("4h or daily", "Entry in discount (buy) / premium (sell) of", options = ["4h or daily", "4h and daily", "Off"], group = G_COND, tooltip = "Dealing range of the 4h and daily candles (last swing high / low, completed candles).")
string iBiasMode = input.string("Teacher", "Daily bias", options = ["Teacher", "Simple"], group = G_COND, tooltip = "Teacher (top-down): yesterday rejected from a daily FVG (came in, closed back beyond its 50%) -> that direction; otherwise premium (bearish) / discount (bullish) of…")
string iMssMkt = input.string("Off", "Enter at market on the MSS candle if already in discount / premium", options = ["Off", "4h or daily range", "Setup range"], group = G_COND, tooltip = "User option: do not wait for the retrace into the FVG when, on the MSS candle, price already sits in discount (buy) / premium (sell).")
string iNoFvgPd = input.string("Skip", "No-FVG entry on the wrong side of the 50%", options = ["Skip", "Clamp to 50%", "Off"], group = G_COND, tooltip = "Never sell in discount / buy in premium: Skip = wait until price is back in premium (sell) / discount (buy), Clamp = limit at the 50% of the move.")
bool   iFvgDisp = input.bool(true, "Entry FVG only inside the displacement leg", group = G_COND, tooltip = "From the hunt / zone extreme to the top (buy) or bottom (sell) of the move that broke structure; an FVG of a later pullback does not count.")
bool   iRevDR   = input.bool(true, "Reversal only in discount (buy) / premium (sell) of the move it retraces", group = G_COND, tooltip = "Channel video on dealing range & SDP: if -2..-2.5 is still in premium for a buy (discount for a sell), wait for -3.5..-4.")
bool   iMOHard  = input.bool(true, "NY Open is a hard rule (no signal on the wrong side)", group = G_COND, tooltip = "Course video 10: below the NY midnight open we look for buys, above it for sells. Off: the signal only gets grade B with a warning.")
bool   iUseSessLiq = input.bool(true, "Session highs/lows (Asia/London/NY) are liquidity", group = G_COND)
bool   iDR      = input.bool(true, "Dealing range: buy in discount / sell in premium, fake MSS = turtle soup", group = G_COND, tooltip = "ICT dealing range of each setup, between the swing that took buy-side liquidity (BSL) and the one that took sell-side liquidity (SSL). Zone reversal: fib 1 of the SDP (the hunt) to the zone extreme. Hunt setup: the hunt to the last opposite stop hunt beyond it (else its fib 0). A higher high / lower low after the MSS widens it. Buy only below its 50% (discount), sell only above (premium); the entry FVG must be on that side too.")
bool   iDisp    = input.bool(true, "Require displacement after the MSS", inline = "d", group = G_COND)
float  iDispAtr = input.float(1.0, "candle >= ATR x", minval = 0.1, step = 0.1, inline = "d", group = G_COND)
bool   iPD       = input.bool(true, "FVG in discount (buy) / premium (sell)", group = G_COND)
bool   iUB      = input.bool(true, "Skip if equal lows/highs are left near the entry (unfinished business)", inline = "u", group = G_COND)
float  iUBPips  = input.float(10.0, "pips beyond SL", inline = "u", group = G_COND)
bool   iUBEq    = input.bool(true, "Equal lows/highs near the entry block the signal (off = warning, grade B)", group = G_COND)
bool   iHtfReq = input.bool(false, "Require HTF direction (notes: higher win rate)", group = G_COND)
bool   iWarnTrend = input.bool(true, "⚠ reduce-size mark also against the daily trend", group = G_COND)
bool   iUseMinStop = input.bool(true, "Minimum stop distance — not in notes", group = G_COND)
bool   iUseNews    = input.bool(true, "No signal around red news", group = G_COND)
string iZeroMode = input.string("Last swing", "Fib 0 of a stop-hunt leg", options = ["Last swing", "Previous stop hunt", "Swing that took the one before"], tooltip = "Previous stop hunt (your chart 2026-09-24): fib 0 = the last opposite swing that itself hunted session / day / week liquidity (the previous leg's fib 1), or a more…", group = G_COND)
bool   iSbEntry = input.bool(false, "Silver bullet entry at -1..-1.5 (with the move, target -2)", tooltip = "Notes MZ p.26 #8 / p.29 #38: in silver-bullet time with price at -1..-1.5 we expect the move to go on to -2..-2.5: a 2022 setup on the pullback, in the direction of…", group = G_COND)
bool   iChain   = input.bool(true, "SDP legs only from hunts at the previous leg's zones or of external liquidity", tooltip = "Small hunts of internal swings elsewhere do not make a leg (less clutter, the main leg is not pushed out).", group = G_COND)
bool   iSupersede = input.bool(true, "Deeper stop hunt replaces the previous SDP", tooltip = "Videos: the SDP is drawn from the last swing that hunted - when a new swing hunts beyond fib 1 of a same-side SDP, or hunts again from the same fib 0, and that SDP…", group = G_COND)
bool   iChainIth = input.bool(true, "An ITH/ITL hunt also starts a new SDP chain", tooltip = "Videos: the main swing is the one that hunted external liquidity (session / day / week high or low).", group = G_COND)
bool   iHuntZone = input.bool(false, "Stop hunt + MSS only at -2..-2.5 / -3.5..-4 of the previous leg", tooltip = "On: a stop hunt anywhere else gives no signal. 1 year EURUSD (with the hunt candle as displacement): off 109 trades +59.7R DD 6R, on 77 trades +39.6R DD 8R.", group = G_COND)
bool   iDispHunt = input.bool(true, "Hunt candle counts as displacement", tooltip = "The candle that made the hunt low / high and closed strongly the other way is the displacement; the FVG it leaves (its middle candle) counts.", group = G_COND)
float  iAgainstLive = input.float(0.0, "Hunt setup against a live SDP: blocked inside its 0..-x (0 = -2 zone, -1 = never)", minval = -1, step = 0.5, group = G_COND, tooltip = "Notes: at -1..-1.5 we only save profit and never trade against the move.")
bool   iFS      = input.bool(true, "Failure swing SDP (big hunt leg: FS -2..-2.5 overlapping main -1..-1.5)", group = G_COND)
string iFsOnly  = input.string("Off", "…then only the failure-swing leg counts", options = ["Off", "Main leg zones", "Every setup of the main leg"], group = G_COND, tooltip = "User rule: when the failure swing is valid, the main stop-hunt leg is no longer used - Main leg zones: its -2..-2.5 / -3.5..-4 reversals are replaced by the FS leg;…")
float  iFsBig   = input.float(0.0, "…failure swing only when the hunt leg >= x ATR (0 = any)", minval = 0, step = 0.5, group = G_COND, tooltip = "Big stop-hunt leg: 0..1 of the main leg at least x times ATR(14). 1 year EURUSD with zones-only: 2 ATR +53.5R, 3 ATR +51.1R (FS trades 86% win).")
bool   iHunt     = input.bool(true, "2022 setup on the stop-hunt leg (continuation) — notes rules 16-17 forbid it; most signals come from it", tooltip = "Sell-side hunted → MSS above fib 0 → retrace below the NY Open into a discount FVG → BUY (mirror for sells).", group = G_COND)

bool   STRICT = iMode == "Strict (notes)"

const string G_TF = "⏰ Time filters (on/off)"
bool   iUseSB   = input.bool(true, "Silver bullet time counts as a confirmation", group = G_TF)

const string G_T = "⏰ Trade windows (NY) — LKZ 2-5, NYKZ 7-10, SB 10-11 / 14-15"
bool   iW1  = input.bool(true, "London KZ", inline = "w1", group = G_T)
string sW1  = input.session("0200-0500", "", inline = "w1", group = G_T)
bool   iW2  = input.bool(true, "NY KZ", inline = "w2", group = G_T)
string sW2  = input.session("0700-1000", "", inline = "w2", group = G_T)
bool   iW3  = input.bool(true, "Silver Bullet AM", inline = "w3", group = G_T)
string sW3  = input.session("1000-1100", "", inline = "w3", group = G_T)
bool   iW4  = input.bool(true, "Silver Bullet PM", inline = "w4", group = G_T)
string sW4  = input.session("1400-1500", "", inline = "w4", group = G_T)
string sSB1 = input.session("0300-0400", "Silver bullet London (confirmation)", group = G_T)
string sSB2 = input.session("1000-1100", "Silver bullet AM (confirmation)", group = G_T)
string sSB3 = input.session("1400-1500", "Silver bullet PM (confirmation)", group = G_T)

const string G_L = "💧 Liquidity for a valid stop hunt"
string sAsia    = input.session("1900-0100", "Asia session", group = G_L)
string sLon     = input.session("0200-0700", "London session", group = G_L)
string sNYs     = input.session("0700-1700", "New York session", group = G_L)
int    iSwingLB = input.int(200, "Old high/low lookback (bars)", minval = 10, group = G_L)
float  iEqPips  = input.float(2.0, "Equal highs/lows tolerance (pips)", group = G_L)

const string G_S = "📐 SDP (fib 1 = hunt swing, 0 = last swing before it)"
int    iPivot  = input.int(1, "Swing length (1 = 3-candle swing)", minval = 1, group = G_S)
float  iZ1a    = input.float(1.0, "Retrace zone: from -", inline = "z1", group = G_S)
float  iZ1b    = input.float(1.5, "to -", inline = "z1", group = G_S)
float  iZ2a    = input.float(2.0, "Reverse zone 1: from -", inline = "z2", group = G_S)
float  iZ2b    = input.float(2.5, "to -", inline = "z2", group = G_S)
float  iZ3a    = input.float(3.5, "Reverse zone 2: from -", inline = "z3", group = G_S)
float  iZ3b    = input.float(4.0, "to -", inline = "z3", group = G_S)
bool   iZ2Grace = input.bool(true, "Close beyond -2.5: next candle may reclaim it", group = G_S, tooltip = "Course video 10 (26:32): a close beyond -2.5 that the next candle closes back inside of keeps -2..-2.5 valid; a second close beyond kills it and we wait for -3.5..-4")
int    iLegAge = input.int(192, "Forget a leg after (bars) — not in notes", group = G_S)
float  iMinLeg = input.float(5.0, "Min leg size (pips) — not in notes", group = G_S)
int    iMaxLegs = input.int(3, "Live legs per direction — not in notes", minval = 1, maxval = 6, group = G_S)

const string G_E = "🎯 Entry: ICT 2022 setup at the zone"
int    iIthLB    = input.int(60, "ITH/ITL search window (bars)", group = G_E)
string iEdge     = input.string("CE (50%)", "FVG entry", options = ["Proximal", "CE (50%)"], group = G_E)
bool   iLtf      = input.bool(true, "No FVG in discount/premium on the chart: look on a lower timeframe", group = G_E, tooltip = "Course: the analysis is on 15 min, the entry FVG may be on 5 min. Drawn as a box with FVG 5m.")
string iLtfTf    = input.timeframe("5", "Lower timeframe (entry FVG + zone MSS)", group = G_E)
bool   iLtfMss   = input.bool(true, "Zone reached: also look for the stop hunt + MSS + 2022 setup on the lower timeframe", group = G_E, tooltip = "When price is in -2..-2.5 / -3.5..-4 and the 15m chart shows no MSS yet, the lower timeframe is checked too: its extreme takes an LTF swing (stop hunt), the next LTF candles break the LTF swing before the extreme (MSS) with displacement, then the FVG. The entry leg (and its targets) is drawn on that timeframe (notes: the target is measured on the timeframe of the entry).")
bool   iShowFvg  = input.bool(true, "Entry FVG box + BUY / SELL arrow on the entry candle", group = G_E)
float  iSlPips   = input.float(0.0, "SL buffer beyond fib 1 (pips, 0 = exactly on fib 1)", minval = 0, step = 0.5, group = G_E, tooltip = "User: stop exactly on fib 1 of the SDP.")
float  iTpBuf    = input.float(0.2, "TP buffer before the level (pips)", step = 0.1, group = G_E, tooltip = "Video 12: put the target 1-2 pipettes before the zone so it surely gets touched")
float  iMinStop  = input.float(3.0, "Min stop distance (pips) — not in notes", minval = 0, group = G_E)
int    iValidMin = input.int(120, "Limit order valid (min) — not in notes", group = G_E)

const string G_D = "📏 Dealing range (MZ ICT knowledge base)"
bool   iShowDR   = input.bool(true, "Draw the dealing range of each signal (BSL top, SSL bottom, premium / discount)", group = G_D, tooltip = "Two boxes from the BSL and SSL swings of the setup to the signal: premium above the 50%, discount below. A buy is only given in discount, a sell only in premium (setting \"Dealing range\" above).")

const string G_R = "💰 Targets & management"
const string TGT_DR = "Dealing range + SDP zones"
string iTgtMode = input.string(TGT_DR, "Targets", options = [TGT_DR, "SDP of entry leg", "External liquidity"], tooltip = "Dealing range + SDP zones: the target is in premium (buy) / discount (sell) of the dealing range. Going out from the entry, the first SDP zone of the entry leg that lies fully on that side gives the target at its first level: -1..-1.5 -> -1, -2..-2.5 -> -2, -3.5..-4 -> -3.5. A zone that is partly in premium and partly in discount -> the 50% of the dealing range. No zone gets there -> the 50%. External liquidity: partial at 50% of the dealing range, target = fib 1 of the stop-hunt leg (internal -> external). SDP: partial at -1, target at -2 of the entry leg.", group = G_R)
float iTgt      = input.float(2.0, "SDP mode: main target = - level of the entry leg", group = G_R)
float iPart     = input.float(1.0, "SDP mode: partial at - level (stop NOT moved)", group = G_R)
float iPartFrac = input.float(0.6, "Partial size (1 = close everything at the partial)", minval = 0.1, maxval = 1.0, step = 0.1, group = G_R, tooltip = "Course video 11: close 60-70% of the position at -1..-1.5. 1 = full exit at the partial level. 1 year EURUSD: 0.6 +61.4R (simple) / +54.1R (full rules); 1.0 +52.5R / +49.5R, same win rate.")
float iMaxRR    = input.float(4.0, "Cap target at R", group = G_R, tooltip = "Dealing range mode: the cap never pulls the target back below the 50% (buy) / above it (sell).")
float iMinRR    = input.float(1.0, "Min R:R (0 = off) — not in notes", minval = 0, step = 0.1, group = G_R, tooltip = "A target at the 50% of the dealing range can sit very close to an entry that is just inside discount / premium; such setups are skipped.")

const string G_C = "✅ Confirmations (grade)"
bool   iUse3PD = input.bool(true, "3 PD arrays failed", group = G_C)
bool   iUseHTF = input.bool(true, "Higher timeframe direction", inline = "h", group = G_C)
string iHtf    = input.timeframe("240", "", inline = "h", group = G_C)
bool   iUseSMT = input.bool(true, "SMT with", inline = "s", group = G_C)
string iSmtSym = input.symbol("FOREXCOM:GBPUSD", "", inline = "s", group = G_C)
bool   iSmtInv = input.bool(false, "SMT symbol is inversely correlated (DXY)", group = G_C)
float  iPipOvr = input.float(0.0, "Pip size override (0 = auto)", group = G_C)

const string G_N = "📰 Red news (manual list; the server filters automatically)"
bool   iNewsOn     = input.bool(true, "Enable manual news list", group = G_N)
bool   iFomc       = input.bool(true, "Built-in FOMC days 2025-2026 (no trade that NY day)", group = G_N, tooltip = "FOMC statement days at 14:00 NY, published by the Fed. Added even when the manual list is empty. CPI / NFP / other red news: add them to the list below (NY time).")
string iNewsList   = input.text_area("", "Red news times, NY time, one per line: 2026-09-24 08:30 (add CPI / NFP / FOMC after the time for the big ones)", group = G_N)
int    iNewsBefore = input.int(60, "Minutes before", group = G_N)
int    iNewsAfter  = input.int(60, "Minutes after", group = G_N)
bool   iNewsDay    = input.bool(true, "CPI / NFP / FOMC: skip the whole NY day", group = G_N, tooltip = "Course video 13: on the day of these news no trade from NY 00:00; the block lasts until the minutes-after below")
int    iMajorAfter = input.int(720, "CPI / NFP / FOMC: minutes after (720 = 12 hours)", group = G_N)
bool   iNewsClose  = input.bool(true, "Close open trades inside the news window", group = G_N)

const string G_A = "🔔 Alerts / webhook"
string iPass      = input.string("change-me", "Webhook passphrase", group = G_A)
string iMinGrade  = input.string("B", "Min grade to alert", options = ["B", "A", "A+"], group = G_A)
bool   iAlUpdates = input.bool(true, "Alert trade updates (fill / cancel / expired / TP / SL)", group = G_A)
string iAlFmt     = input.string("Text (phone / popup)", "Alert message", options = ["Text (phone / popup)", "JSON (webhook bot)"], group = G_A, tooltip = "Text: readable message for the TradingView app, popup and email. JSON: for the webhook server / Telegram bot.")

const string G_V = "🎨 Visuals"
bool  iShowLegs  = input.bool(true, "SDP legs with fib levels", group = G_V)
bool  iShowBoxes = input.bool(false, "Zone / FVG rectangles", group = G_V)
bool  iShowMss   = input.bool(true, "MSS line (red, like the notes)", group = G_V)
bool  iMssDraw   = input.bool(true, "Draw an SDP only after its MSS (price crossed its 0)", tooltip = "Videos (SDP, 07:10): we draw the SDP once we are sure the stop hunt happened - when there is a market structure shift.", group = G_V)
bool  iFibTv     = input.bool(true, "SDP like the TradingView fib tool (lines only as wide as 0..1, solid, not extended)", group = G_V)
int   iFibLen    = input.int(20, "Fib line length after fib 1 (bars, 0 = up to price)", minval = 0, group = G_V)
string iView     = input.string("Clean", "Display", options = ["Clean", "Full"], tooltip = "Clean: one SDP per side (the one in a setup, otherwise the newest) + legs that traded. Full: every leg the bot tracks, with finished legs kept (see History).", group = G_V)
string iTxtSize  = input.string("Normal", "SDP text size", options = ["Small", "Normal", "Large", "Huge"], group = G_V)
string iSigSize  = input.string("Normal", "Signal text size (box, Entry / SL / TP, markers)", options = ["Small", "Normal", "Large", "Huge"], group = G_V)
string iNoteSize = input.string("Tiny", "Notes / MSS text size", options = ["Tiny", "Small", "Normal", "Large"], group = G_V)
string iDashSize = input.string("Small", "Dashboard text size", options = ["Small", "Normal", "Large"], group = G_V)
bool  iFibLeft   = input.bool(true, "Fib labels on the left (like the TradingView fib tool)", group = G_V)
string iHist     = input.string("All legs", "History (Full display): keep finished legs", options = ["All legs", "Traded legs only", "Live legs only"], inline = "hist", group = G_V)
int   iHistN     = input.int(20, "last", minval = 1, maxval = 40, inline = "hist", tooltip = "TradingView allows 500 lines/labels per indicator, so only the most recent finished legs are kept. Each one shows why it ended without a trade.", group = G_V)
bool  iShowTrade = input.bool(true, "Entry / SL / targets", group = G_V)
bool  iShowMO    = input.bool(true, "NY Open line", group = G_V)
bool  iShowWin   = input.bool(true, "Shade trade windows", group = G_V)
bool  iShowRej   = input.bool(true, "Show why an MSS / setup gave no signal", group = G_V)
int   iNotesN    = input.int(3, "…keep only the last N notes (0 = all)", minval = 0, group = G_V)
int   iDrawDays  = input.int(2, "SDPs / MSS / notes / signal lines: only the last N days (0 = all)", minval = 0, group = G_V, tooltip = "Signal boxes and entry arrows are kept for the whole history (grey = cancelled / expired, with the result on filled ones).")
bool  iCompact   = input.bool(true, "Compact signal box (details in the tooltip - hover the box)", group = G_V)
bool  iOldSig    = input.bool(true, "Older signals as small ▲ / ▼ markers with the result", group = G_V, tooltip = "Signals older than the N days above are drawn as a small marker under / over the candle; it turns into the result (+4.0R / -1.0R).")
bool  iOldLbl    = input.bool(false, "…older signals: Entry / SL / TP price text too (uses many labels)", group = G_V, tooltip = "TradingView keeps at most 500 labels per indicator; with this on, the oldest signal markers drop off the chart.")
bool  iOldCanc   = input.bool(true, "…also keep cancelled / expired older signals (grey ✕ / ⌛)", group = G_V)
bool  iShowDash  = input.bool(true, "Dashboard", group = G_V)
int   iLineBars  = input.int(20, "Signal line length (bars)", minval = 5, maxval = 400, group = G_V)
string iDayLine  = input.string("NY midnight", "Yellow line at each day start", options = ["Off", "NY midnight", "Daily candle (17:00 NY)"], group = G_V)
color cBuy       = input.color(#089981, "Buy", inline = "c", group = G_V)
color cSell      = input.color(#f23645, "Sell", inline = "c", group = G_V)
bool  DRAW       = iDrawDays == 0 or time >= last_bar_time - iDrawDays * 86400000  // from the last bar (weekends: the last trading days)
bool  iOneSwing  = input.bool(false, "One trade per stop-hunt swing (skip a 2nd setup with the same stop)", group = G_V, tooltip = "The reversal at the zone and the hunt-leg setup often come from the same stop hunt (same stop). 1 year EURUSD: off 85 trades +53.0R; on 78 trades +41.9R.")
var array<int> usedStops = array.new<int>()
bool  iTfLock    = input.bool(true, "Signals only on the 15m chart", group = G_V, tooltip = "The rules and the backtests are for 15 min.")
bool  TFOK       = not iTfLock or timeframe.period == "15"
bool  iSimple    = input.bool(true, "Simple mode: stop hunt + MSS + right side of the dealing range", group = G_V, tooltip = "User: a stop hunt with MSS whose entry is in discount (buy) / premium (sell) is signalled; the extra filters (against a live SDP, NY Open side, 4h / daily range) are off. Killzones and red news stay. 1 year EURUSD: 200 trades 38.5% win +63.4R DD 9.6R (about 8 signals a week) vs full rules 85 trades 45.9% +53.0R DD 5.5R.")
bool  iOnRetrace = input.bool(false, "Signal only when price returns to the FVG (15m / 5m)", group = G_A, tooltip = "On: the signal (and its alert) comes when price touches the entry on the FVG - no limit order to manage, no expired signals on the chart. Off: the signal comes right at the MSS with a limit order on the FVG.")
bool  iMktEntry = input.bool(false, "Enter at market when the signal comes (do not wait for the FVG)", group = G_A, tooltip = "User rule: the FVG (15m / 5m) is still found and drawn, but the signal is a market entry at the signal candle close - no limit order, nothing gets cancelled. The entry must still be in discount (buy) / premium (sell) of the setup range, otherwise no signal. Off: limit order on the FVG. Ignored when \"Signal only when price returns to the FVG\" is on.")
bool  MOF        = iMO and not iSimple
float AGL        = iSimple ? -1.0 : iAgainstLive
string HTFF      = iSimple ? "Off" : iHtfFilter
color cEntry     = input.color(#2962ff, "Entry", inline = "c", group = G_V)

type Level
    string name
    float  price
    int    bar
    bool   bsl
    string kind
    bool   swept = false

type Sweep
    int    bar
    bool   bsl
    string name
    string kind
    float  price

type Sess
    bool  active = false
    int   key
    float hi
    float lo
    int   hiBar
    int   loBar

type Gap
    int   bar
    float top
    float bottom
    bool  bull
    bool  filled = false
    bool  ltf = false
    int   t1 = 0
    int   t2 = 0
    int   b0 = -1
    bool  nofvg = false
    bool  atMss = false

type Hunt
    bool   bear
    float  one
    float  zero
    int    bar
    float  level
    string names
    bool   external
    int    parent = -1
    int    zeroBar = -1

// lower-timeframe follow-up of one setup: extreme candle, stop hunt, MSS of the LTF swing before the extreme
type Ltf
    int   xi = -1     // running index of the LTF extreme candle (-1 = not started)
    float xp
    int   xt = 0      // its open time
    int   last = -1   // last LTF candle walked
    bool  hunt = false
    bool  mss = false // the setup's MSS came from this lower timeframe
    float zero        // LTF swing it broke = fib 0 of the LTF entry leg
    int   zeroBar = -1

type Leg
    bool         bear
    float        one
    float        zero
    int          oneBar
    int          createdBar
    string       names
    bool         z2Alive = true
    bool         z3Alive = true
    int          z2Pend = -1
    string       zone = ""
    int          touchBar = -1
    float        extreme
    int          extremeBar = -1
    float        mssLevel
    int          mssBar = -1
    int          ithBar = -1
    bool         tsoup = false
    bool         cMss = false
    int          cMssBar = -1
    float        cFar
    bool         cDone = false
    float        cLevel
    int          cLvlBar = -1
    bool         cMssDrawn = false
    string       note = ""
    bool         fs = false
    int          parentBar = -1
    float        drOne
    bool         hasFs = false
    bool         redraw = false
    int          zeroBar = -1
    string       endWhy = ""
    bool         done = false
    bool         signaled = false
    bool         inZone = false
    bool         mssOk = false
    int          sbTouch = -1
    float        sbExt
    int          sbExtBar = -1
    bool         sbMss = false
    bool         sbDone = false
    float        sbLvl
    Ltf          z5              // lower timeframe at the -2 / -3.5 zone
    Ltf          c5              // lower timeframe on the stop-hunt leg (hunt setup)
    bool         oppDone = false // dealing range of the hunt setup: last opposite stop hunt beyond it
    float        oppPx
    int          oppBar = -1
    bool         cleaned = false
    array<line>  lns
    array<label> lbs
    array<box>   bxs

type Trade
    string id
    bool   sell
    float  entry
    float  stop
    float  tp1
    float  tpMain
    int    validUntil
    bool   market
    int    state = 0
    float  risk
    float  remaining = 1.0
    float  realized = 0.0
    bool   partialDone = false
    int    legBar = -1
    label  lab
    bool   mini = false
    string tip = ""
    string kind = ""     // setup on the small marker: zone -2 / -3.5, hunt, FS, SB
    string warn = ""
    array<line>  lns
    array<label> lls
    array<box>   bxs

type Stats
    int   signals = 0
    int   closed = 0
    int   wins = 0
    int   losses = 0
    float totalR = 0.0
    int   dayCount = 0
    int   rejected = 0
    int   liveLeg = -1
    int   noteBarUp = -100
    int   noteSlotUp = 0
    int   noteBarDn = -100
    int   noteSlotDn = 0
    string noteTxtUp = ""
    int    noteTxtUpBar = -100
    string noteTxtDn = ""
    int    noteTxtDnBar = -100

f_hm(string s, int pos) => int(str.tonumber(str.substring(s, pos, pos + 2)))
f_sStart(string s) => f_hm(s, 0) * 60 + f_hm(s, 2)
f_sEnd(string s) => f_hm(s, 5) * 60 + f_hm(s, 7)
f_in(int m, int s, int e) => e > s ? (m >= s and m < e) : (m >= s or m < e)
f_dateKey(int t) => year(t, TZ) * 10000 + month(t, TZ) * 100 + dayofmonth(t, TZ)
f_key(int s, int e) => f_dateKey(e <= s ? time - e * 60000 : time)

bool   iClean     = iView == "Clean"
f_size(string v) => v == "Tiny" ? size.tiny : v == "Small" ? size.small : v == "Large" ? size.large : v == "Huge" ? size.huge : size.normal
string sTxt       = f_size(iTxtSize)
string sSig       = f_size(iSigSize)
string sSigOld    = f_size(iSigSize == "Huge" ? "Large" : iSigSize == "Large" ? "Normal" : iSigSize == "Normal" ? "Small" : "Tiny")
string sNote      = f_size(iNoteSize)
string sDash      = f_size(iDashSize)
string sBox       = iTxtSize == "Large" or iTxtSize == "Huge" ? size.small : size.tiny
string TK         = syminfo.ticker
bool   isFX       = syminfo.type == "forex"
float  PIP        = iPipOvr > 0 ? iPipOvr : str.startswith(TK, "XAU") ? 0.1 : str.startswith(TK, "XAG") ? 0.01 : isFX ? (str.contains(TK, "JPY") ? 0.01 : 0.0001) : 1.0
int    mod        = hour(time, TZ) * 60 + minute(time, TZ)
int    calKey     = f_dateKey(time)
int    TF_MIN     = math.max(1, int(timeframe.in_seconds() / 60))
int    validBars  = math.max(1, int(math.ceil(float(BEST ? 480 : iValidMin) / TF_MIN)))
bool   useDR      = iDR
bool   useHZ      = iHuntZone and not BEST
int    barsPerDay = math.min(480, int(1440 / TF_MIN))

f_num(float v) => na(v) ? "null" : str.tostring(v, format.mintick)
f_q(string s) => "\"" + s + "\""
f_b(bool b) => b ? "true" : "false"
f_gradeRank(string g) => g == "A+" ? 2 : g == "A" ? 1 : 0

f_fib(Leg lg, float k) => lg.zero + k * (lg.one - lg.zero)
f_lvl(Leg lg, float k) => f_fib(lg, -k)
f_beyond(bool bear, float px, float lvl) => bear ? px < lvl : px > lvl
f_reach(bool bear, float ext, float lvl) => bear ? ext <= lvl : ext >= lvl

f_lastBefore(array<int> bars, array<float> prices, int x) =>
    float r = na
    int n = bars.size()
    if n > 0
        for i = n - 1 to 0
            if bars.get(i) < x
                r := prices.get(i)
                break
    r

f_lastBarBefore(array<int> bars, int x) =>
    int r = -1
    int n = bars.size()
    if n > 0
        for i = n - 1 to 0
            if bars.get(i) < x
                r := bars.get(i)
                break
    r

var array<int>   hsHB = array.new<int>()
var array<float> hsHP = array.new<float>()
var array<int>   hsLB = array.new<int>()
var array<float> hsLP = array.new<float>()
f_huntOrigin(array<int> bars, array<float> prices, int x, bool lowSwings) =>
    float zp = na
    int zb = -1
    int n = bars.size()
    int last = -1
    if n > 0
        for k = n - 1 to 0
            if bars.get(k) < x
                last := k
                break
    if last >= 0
        zp := prices.get(last)
        zb := bars.get(last)
        bool done = false
        if iZeroMode == "Previous stop hunt"
            array<int> hb = lowSwings ? hsLB : hsHB
            array<float> hp = lowSwings ? hsLP : hsHP
            int m = hb.size()
            if m > 0
                for k = m - 1 to 0
                    int b = hb.get(k)
                    if b < x
                        if x - b <= iSwingLB
                            zp := hp.get(k)
                            zb := b
                            for j = 0 to last
                                if bars.get(j) > b and (lowSwings ? prices.get(j) < zp : prices.get(j) > zp)
                                    zp := prices.get(j)
                                    zb := bars.get(j)
                            done := true
                        break
        if not done and iZeroMode != "Last swing" and last >= 1
            for k = last to math.max(1, last - 20)
                float pk = prices.get(k)
                float pp = prices.get(k - 1)
                if lowSwings ? pk < pp : pk > pp
                    zp := pk
                    zb := bars.get(k)
                    break
    [zp, zb]

f_cisdAt(int ox, bool bearishDelivery) =>
    float lvl = open[ox]
    int j = -1
    for k = ox to ox + 2
        bool d = bearishDelivery ? close[k] > open[k] : close[k] < open[k]
        if d
            j := k
            break
    if j >= 0
        int first = j
        for k = j + 1 to ox + 10
            bool d = bearishDelivery ? close[k] > open[k] : close[k] < open[k]
            if d
                first := k
            else
                break
        lvl := open[first]
    lvl

f_htfTrend() =>
    var int state = 0
    var float lastPH = na
    var float lastPL = na
    float hp = ta.pivothigh(high, 1, 1)
    float lp = ta.pivotlow(low, 1, 1)
    if not na(hp)
        lastPH := hp
    if not na(lp)
        lastPL := lp
    if not na(lastPH) and close > lastPH
        state := 1
        lastPH := na
    else if not na(lastPL) and close < lastPL
        state := -1
        lastPL := na
    nz(state[1])

float atr14 = ta.atr(14)
float rngHi = ta.highest(high, 30)
float rngLo = ta.lowest(low, 30)
float ph = ta.pivothigh(high, iPivot, iPivot)
float pl = ta.pivotlow(low, iPivot, iPivot)
int htfTrend = request.security(syminfo.tickerid, iHtf, f_htfTrend(), lookahead = barmerge.lookahead_on)
int dTrend = request.security(syminfo.tickerid, "D", f_htfTrend(), lookahead = barmerge.lookahead_on)
f_dailyCtx() =>
    int b = close[1] > high[2] ? 1 : close[1] < low[2] ? -1 : high[1] > high[2] and close[1] < high[2] ? -1 : low[1] < low[2] and close[1] > low[2] ? 1 : 0
    var float bT = na
    var float bB = na
    var float sT = na
    var float sB = na
    if low > high[2]
        bT := low
        bB := high[2]
    if high < low[2]
        sT := low[2]
        sB := high
    if not na(bB) and close < bB
        bT := na
        bB := na
    if not na(sT) and close > sT
        sT := na
        sB := na
    var float drHi = na
    var float drLo = na
    if high[2] > high[3] and high[2] > high[1]
        drHi := math.max(high[2], high[1])
    else if not na(drHi)
        drHi := math.max(drHi, high[1])
    if low[2] < low[3] and low[2] < low[1]
        drLo := math.min(low[2], low[1])
    else if not na(drLo)
        drLo := math.min(drLo, low[1])
    int react = not na(sB[2]) and high[1] >= sB[2] and close[1] < (sB[2] + sT[2]) / 2 ? -1 : not na(bB[2]) and low[1] <= bT[2] and close[1] > (bB[2] + bT[2]) / 2 ? 1 : 0
    [b, bT[1], bB[1], sT[1], sB[1], drHi, drLo, react]
f_htfDr() =>
    var float hi = na
    var float lo = na
    if high[2] > high[3] and high[2] > high[1]
        hi := math.max(high[2], high[1])
    else if not na(hi)
        hi := math.max(hi, high[1])
    if low[2] < low[3] and low[2] < low[1]
        lo := math.min(low[2], low[1])
    else if not na(lo)
        lo := math.min(lo, low[1])
    [hi, lo]
[h4DrHi, h4DrLo] = request.security(syminfo.tickerid, "240", f_htfDr(), lookahead = barmerge.lookahead_on)
[dBiasS, dBT, dBB, dST, dSB, dDrHi, dDrLo, dReact] = request.security(syminfo.tickerid, "D", f_dailyCtx(), lookahead = barmerge.lookahead_on)
bool  dDrOk = not na(dDrHi) and not na(dDrLo) and dDrHi > dDrLo
float dDrEq = dDrOk ? (dDrHi + dDrLo) / 2 : na
int   dBias = iBiasMode == "Simple" ? dBiasS : dReact != 0 ? dReact : dDrOk ? (close > dDrEq ? -1 : 1) : 0
[smtH, smtL] = request.security(iUseSMT ? iSmtSym : syminfo.tickerid, timeframe.period, [high, low])

var array<Level> levels = array.new<Level>()
var array<Sweep> sweeps = array.new<Sweep>()
var array<Gap>   gaps   = array.new<Gap>()
var array<Hunt>  hunts  = array.new<Hunt>()
var array<Hunt>  fsq    = array.new<Hunt>()
