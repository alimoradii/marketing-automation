f_sess(Sess s, string sess, string name) =>
    int a = f_sStart(sess)
    int e = f_sEnd(sess)
    bool inside = f_in(mod, a, e)
    int key = f_key(a, e)
    if s.active and (not inside or key != s.key)
        f_removeLevels("session", name + " ")
        if iUseSessLiq
            levels.push(Level.new(name + " High", s.hi, s.hiBar, true, "session"))
            levels.push(Level.new(name + " Low", s.lo, s.loBar, false, "session"))
        s.active := false
    if inside
        if not s.active
            s.active := true
            s.key := key
            s.hi := high
            s.lo := low
            s.hiBar := bar_index
            s.loBar := bar_index
        else
            if high > s.hi
                s.hi := high
                s.hiBar := bar_index
            if low < s.lo
                s.lo := low
                s.loBar := bar_index
    inside

f_sess(ssAsia, sAsia, "Asia")
f_sess(ssLon, sLon, "London")
f_sess(ssNY, sNYs, "NY")

if bar_index >= 2
    if low > high[2]
        gaps.push(Gap.new(bar_index, low, high[2], true))
    else if high < low[2]
        gaps.push(Gap.new(bar_index, low[2], high, false))
if gaps.size() > 80
    gaps.shift()
for g in gaps
    if g.bar < bar_index and not g.filled
        if (g.bull and close < g.bottom) or (not g.bull and close > g.top)
            g.filled := true

bool LTF_DATA = (iLtf or iLtfMss) and timeframe.in_seconds() > timeframe.in_seconds(iLtfTf)
bool LTF_ON   = LTF_DATA and iLtf
bool LTF_MSS  = LTF_DATA and iLtfMss
int  LTF_MS   = timeframe.in_seconds(iLtfTf) * 1000
int  LTF_N    = math.max(1, int(timeframe.in_seconds() / math.max(1, timeframe.in_seconds(iLtfTf))))
[lH, lL, lC, lT, lO] = request.security_lower_tf(syminfo.tickerid, LTF_DATA ? iLtfTf : timeframe.period, [high, low, close, time, open])
var array<float> l5h = array.new<float>()
var array<float> l5l = array.new<float>()
var array<int>   l5t = array.new<int>()
var array<int>   l5b = array.new<int>()
var array<Gap>   gaps5 = array.new<Gap>()
var array<int>   used5 = array.new<int>()
// lower-timeframe candles for the stop hunt + MSS at the zone; an LTF candle's running index is n5 - size + position
var array<float> x5h = array.new<float>()
var array<float> x5l = array.new<float>()
var array<float> x5o = array.new<float>()
var array<float> x5c = array.new<float>()
var array<float> x5a = array.new<float>()
var array<int>   x5t = array.new<int>()
var array<int>   x5b = array.new<int>()
var int   n5   = 0
var float atr5 = na
var array<int>   s5hI = array.new<int>()
var array<float> s5hP = array.new<float>()
var array<int>   s5lI = array.new<int>()
var array<float> s5lP = array.new<float>()
var array<int>   i5hI = array.new<int>()
var array<float> i5hP = array.new<float>()
var array<int>   i5lI = array.new<int>()
var array<float> i5lP = array.new<float>()
f_p5(int gi) => gi - (n5 - x5h.size())
f_bar5(int gi, int fb) =>
    int pos = f_p5(gi)
    pos >= 0 and pos < x5b.size() ? x5b.get(pos) : fb
f_on5Swing(int gi, float p, bool isHigh) =>
    array<int> sb = isHigh ? s5hI : s5lI
    array<float> sp = isHigh ? s5hP : s5lP
    array<int> ib = isHigh ? i5hI : i5lI
    array<float> ip = isHigh ? i5hP : i5lP
    sb.push(gi)
    sp.push(p)
    int n = sb.size()
    if n >= 3
        float p1 = sp.get(n - 2)
        if isHigh ? (p1 > sp.get(n - 3) and p1 > p) : (p1 < sp.get(n - 3) and p1 < p)
            ib.push(sb.get(n - 2))
            ip.push(p1)
    if sb.size() > 300
        sb.shift()
        sp.shift()
    if ib.size() > 300
        ib.shift()
        ip.shift()
    n
if LTF_DATA and lH.size() > 0
    for j = 0 to lH.size() - 1
        float hh = lH.get(j)
        float ll = lL.get(j)
        float cc = lC.get(j)
        if LTF_MSS
            float pc = x5c.size() > 0 ? x5c.last() : na
            float tr5 = na(pc) ? hh - ll : math.max(hh - ll, math.abs(hh - pc), math.abs(ll - pc))
            atr5 := na(atr5) ? tr5 : (atr5 * 13 + tr5) / 14
            x5h.push(hh)
            x5l.push(ll)
            x5o.push(lO.get(j))
            x5c.push(cc)
            x5a.push(atr5)
            x5t.push(lT.get(j))
            x5b.push(bar_index)
            n5 += 1
            if x5h.size() > 1000
                x5h.shift()
                x5l.shift()
                x5o.shift()
                x5c.shift()
                x5a.shift()
                x5t.shift()
                x5b.shift()
            int s = x5h.size()
            if s >= 3
                float mh = x5h.get(s - 2)
                float ml = x5l.get(s - 2)
                if mh > x5h.get(s - 3) and mh >= hh
                    f_on5Swing(n5 - 2, mh, true)
                if ml < x5l.get(s - 3) and ml <= ll
                    f_on5Swing(n5 - 2, ml, false)
        for g in gaps5
            if not g.filled and (g.bull ? cc < g.bottom : cc > g.top)
                g.filled := true
        l5h.push(hh)
        l5l.push(ll)
        l5t.push(lT.get(j))
        l5b.push(bar_index)
        if l5h.size() > 3
            l5h.shift()
            l5l.shift()
            l5t.shift()
            l5b.shift()
        if l5h.size() == 3
            if ll > l5h.get(0)
                gaps5.push(Gap.new(bar_index, ll, l5h.get(0), true, false, true, l5t.get(0), lT.get(j), l5b.get(0)))
            else if hh < l5l.get(0)
                gaps5.push(Gap.new(bar_index, l5l.get(0), hh, false, false, true, l5t.get(0), lT.get(j), l5b.get(0)))
    while gaps5.size() > 150
        gaps5.shift()

f_gapEntry(Gap g, bool buy) => iEdge == "Proximal" ? (buy ? g.top : g.bottom) : (g.top + g.bottom) / 2
f_drOk(float px, bool buy, float drEq) => not useDR or na(drEq) or (buy ? px < drEq : px > drEq)

// fromT > 0: setup found on the lower timeframe - its FVG starts at the LTF extreme (the hunt candle may be the middle one)
f_best5(bool gapBull, int fromBar, float eq, bool ceRule, int toBar, int fromT, float drEq) =>
    Gap best = na
    if (LTF_ON or fromT > 0) and gaps5.size() > 0
        for g in gaps5
            if g.b0 >= fromBar and g.bar <= toBar and (fromT <= 0 or g.t1 + (iDispHunt ? LTF_MS : 0) >= fromT) and not g.filled and g.bull == gapBull and not used5.includes(g.t2) and f_drOk(f_gapEntry(g, gapBull), gapBull, drEq)
                float ce = (g.top + g.bottom) / 2
                bool pdOk = not iPD or (gapBull ? (ceRule ? ce <= eq : g.bottom <= eq) : (ceRule ? ce >= eq : g.top >= eq))
                if pdOk and (na(best) or (gapBull ? g.top > best.top : g.bottom < best.bottom))
                    best := g
    best

f_useGap(Gap g, bool buy) =>
    if g.ltf and not g.nofvg
        used5.push(g.t2)
        if used5.size() > 100
            used5.shift()
    else if not g.nofvg
        usedFvg.push(buy ? g.bar : -g.bar)
        if usedFvg.size() > 100
            usedFvg.shift()
    g.bar

f_noFvg(bool gapBull, int farBar, float mssPx, float eq) =>
    Gap g = na
    if iNoFvg != "Off" and farBar < bar_index
        float px = iNoFvg == "Market" ? close : iNoFvg == "MSS level" ? mssPx : eq
        if not na(px) and (gapBull ? px > eq : px < eq)
            px := iNoFvgPd == "Skip" ? na : iNoFvgPd == "Clamp to 50%" ? eq : px
        if not na(px)
            g := Gap.new(bar_index, px, px, gapBull, nofvg = true)
    g

f_drawFvg(Gap g, bool buy) =>
    if iShowFvg and DRAW and g.nofvg
        color col = buy ? cBuy : cSell
        line.new(bar_index - 3, g.top, bar_index + 6, g.top, color = color.new(col, 30), style = line.style_dotted)
        label.new(bar_index + 6, g.top, g.atMss ? "market entry on the MSS candle" : "no FVG · entry " + (iNoFvg == "Market" ? "market" : iNoFvg == "MSS level" ? "at MSS" : "at 50%"), style = label.style_none, textcolor = col, size = size.tiny)
    else if iShowFvg and DRAW
        color col = buy ? cBuy : cSell
        int left = g.ltf ? g.t1 : time[math.max(0, bar_index - (g.bar - 2))]
        int right = time + 6 * timeframe.in_seconds() * 1000
        box.new(left, g.top, right, g.bottom, xloc = xloc.bar_time, border_color = color.new(col, 30), bgcolor = color.new(col, 82), text = g.ltf ? "FVG " + iLtfTf + "m" : "FVG", text_size = size.tiny, text_color = col, text_halign = text.align_center, text_valign = text.align_center)
    g.bar

array<Sweep> sweptNow = array.new<Sweep>()
if levels.size() > 0
    for i = levels.size() - 1 to 0
        Level l = levels.get(i)
        if not l.swept and l.bar < bar_index and not na(l.price)
            if (l.bsl and high > l.price) or (not l.bsl and low < l.price)
                l.swept := true
                sweptNow.unshift(Sweep.new(bar_index, l.bsl, l.name, l.kind, l.price))
                levels.remove(i)
for sw in sweptNow
    sweeps.push(sw)
while sweeps.size() > 0 and sweeps.first().bar < bar_index - 10
    sweeps.shift()

f_inter(array<int> ib, array<float> ip, int b, float p) =>
    bool dup = false
    int n = ib.size()
    if n > 0
        for k = n - 1 to math.max(0, n - 3)
            if ib.get(k) == b
                dup := true
    if not dup
        ib.push(b)
        ip.push(p)
    dup

f_onSwing(int i, float price, bool isHigh) =>
    array<int> sb = isHigh ? shB : slB
    array<float> sp = isHigh ? shP : slP
    sb.push(i)
    sp.push(price)
    if sb.size() > 300
        sb.shift()
        sp.shift()
    array<int> ib = isHigh ? ithB : itlB
    array<float> ip = isHigh ? ithP : itlP
    int n = sb.size()
    if n >= 3
        float p0 = sp.get(n - 3)
        float p1 = sp.get(n - 2)
        float p2 = sp.get(n - 1)
        if (isHigh and p1 > p0 and p1 > p2) or (not isHigh and p1 < p0 and p1 < p2)
            int b1 = sb.get(n - 2)
            f_inter(ib, ip, b1, p1)
            for l in levels
                if l.kind == "swing" and l.bar == b1 and not str.startswith(l.name, "Equal")
                    l.name := isHigh ? "ITH" : "ITL"
    int gs = gaps.size()
    if gs > 0
        for k = math.max(0, gs - 40) to gs - 1
            Gap g = gaps.get(k)
            if g.bar < i and not g.filled
                float ci = close[bar_index - i]
                if (isHigh and not g.bull and price >= g.bottom and ci <= g.top) or (not isHigh and g.bull and price <= g.top and ci >= g.bottom)
                    f_inter(ib, ip, i, price)
                    break
    if ib.size() > 300
        ib.shift()
        ip.shift()
    string nm = isHigh ? "Swing High" : "Swing Low"
    if ib.size() > 0 and ib.last() == i
        nm := isHigh ? "ITH" : "ITL"
    for l in levels
        if l.kind == "swing" and l.bsl == isHigh and math.abs(l.price - price) <= iEqPips * PIP
            l.name := isHigh ? "Equal Highs" : "Equal Lows"
            nm := l.name
    levels.push(Level.new(nm, price, i, isHigh, "swing"))
    if iFS
        array<Leg> fb = isHigh ? bearLegs : bullLegs
        for lg in fb
            if not lg.done and not lg.fs and not lg.hasFs and i > lg.oneBar and (isHigh ? price < lg.one : price > lg.one) and (iFsBig <= 0 or na(atr14) or math.abs(lg.one - lg.zero) >= iFsBig * atr14)
                int zb = f_lastBarBefore(isHigh ? slB : shB, i)
                float z = f_lastBefore(isHigh ? slB : shB, isHigh ? slP : shP, i)
                if zb > lg.oneBar and not na(z) and (isHigh ? z < price : z > price) and math.abs(price - z) >= iMinLeg * PIP
                    float u = math.abs(price - z)
                    float a2 = isHigh ? z - iZ2a * u : z + iZ2a * u
                    float b2 = isHigh ? z - iZ2b * u : z + iZ2b * u
                    float a1 = f_lvl(lg, iZ1a)
                    float b1 = f_lvl(lg, iZ1b)
                    if math.max(math.min(a2, b2), math.min(a1, b1)) <= math.min(math.max(a2, b2), math.max(a1, b1))
                        lg.hasFs := true
                        fsq.push(Hunt.new(isHigh, price, z, i, na, lg.names, false, lg.oneBar, zb))
    string names = ""
    bool ext = false
    float key = na
    for sw in sweeps
        bool important = sw.kind != "swing" or sw.name == "Equal Highs" or sw.name == "Equal Lows" or sw.name == "ITH" or sw.name == "ITL" or sw.name == "Hunt High" or sw.name == "Hunt Low"
        if sw.bsl == isHigh and sw.bar >= i - 3 and sw.bar <= i and important
            if not str.contains("," + names + ",", "," + sw.name + ",")
                names := names == "" ? sw.name : names + "," + sw.name
            ext := ext or sw.kind != "swing"
            key := na(key) ? sw.price : isHigh ? math.max(key, sw.price) : math.min(key, sw.price)
    if names != ""
        [zero, zeroB] = f_huntOrigin(isHigh ? slB : shB, isHigh ? slP : shP, i, isHigh)
        Level own = levels.last()
        if own.bar == i
            own.name := isHigh ? "Hunt High" : "Hunt Low"
        if ext
            (isHigh ? hsHB : hsLB).push(i)
            (isHigh ? hsHP : hsLP).push(price)
        if not na(zero) and (isHigh ? zero < price : zero > price) and math.abs(price - zero) >= iMinLeg * PIP
            bool imp = ext or str.contains(names, "Hunt") or (iChainIth and (str.contains(names, "ITH") or str.contains(names, "ITL")))
            hunts.push(Hunt.new(isHigh, price, zero, i, key, names, imp, -1, zeroB))
    names

if not na(ph)
    f_onSwing(bar_index - iPivot, ph, true)
if not na(pl)
    f_onSwing(bar_index - iPivot, pl, false)
if levels.size() > 0
    for i = levels.size() - 1 to 0
        Level l = levels.get(i)
        if l.kind == "swing" and bar_index - l.bar > iSwingLB
            levels.remove(i)

var array<line> dayLines = array.new<line>()
bool newNyDay = dayofmonth(time, "America/New_York") != dayofmonth(time[1], "America/New_York")
bool dChange = timeframe.change("D")
bool dayStart = timeframe.isintraday and bar_index > 0 and (iDayLine == "NY midnight" ? newNyDay : iDayLine == "Daily candle (17:00 NY)" ? dChange : false)
if dayStart
    dayLines.push(line.new(bar_index, low, bar_index, high, extend = extend.both, color = color.new(color.yellow, 40), width = 1))
    if dayLines.size() > 60
        line.delete(dayLines.shift())
var array<line>  mssLines  = array.new<line>()
var array<label> mssLabels = array.new<label>()
f_drawMss(int fromBar, float lvl, string txt) =>
    if iShowMss and DRAW and fromBar >= 0 and fromBar < bar_index
        int t1 = time[bar_index - fromBar]
        int t2 = time
        int tm = int((t1 + t2) / 2)
        int gap = math.max(int((t2 - t1) * 0.14), int(timeframe.in_seconds() * 1000 * 0.6))
        mssLines.push(line.new(t1, lvl, math.max(t1, tm - gap), lvl, xloc = xloc.bar_time, color = color.red, width = 2))
        mssLines.push(line.new(math.min(t2, tm + gap), lvl, t2, lvl, xloc = xloc.bar_time, color = color.red, width = 2))
        mssLabels.push(label.new(tm, lvl, txt, xloc = xloc.bar_time, style = label.style_label_center, color = color.new(color.black, 100), textcolor = color.red, size = sNote == size.tiny ? size.small : sNote))
        if mssLabels.size() > 40
            line.delete(mssLines.shift())
            line.delete(mssLines.shift())
            label.delete(mssLabels.shift())
    mssLines.size()

f_fibEnd(Leg lg) =>
    iFibTv ? math.max(math.max(lg.zeroBar, lg.oneBar), math.min(lg.zeroBar >= 0 ? lg.zeroBar : lg.oneBar, lg.oneBar) + 2) : iFibLen > 0 ? math.min(bar_index + 3, lg.oneBar + iFibLen) : bar_index + 3
f_drawLeg(Leg lg) =>
    if iShowLegs and DRAW
        color col = lg.bear ? cBuy : cSell
        int x2 = f_fibEnd(lg)
        int x1 = lg.zeroBar >= 0 ? math.min(lg.zeroBar, lg.oneBar) : lg.oneBar
        if iFibTv and lg.zeroBar >= 0
            lg.lns.push(line.new(lg.zeroBar, f_fib(lg, 0.0), lg.oneBar, f_fib(lg, 1.0), color = color.new(color.gray, 40), style = line.style_dashed))
        for k in array.from(1.0, 0.786, 0.705, 0.618, 0.5, 0.0, -1.0, -1.5, -2.0, -2.5, -3.5, -4.0)
            float y = f_fib(lg, k)
            if iFibTv
                lg.lns.push(line.new(x1, y, x2, y, color = color.new(color.gray, k < 0 ? 20 : 45), style = line.style_solid))
            else if k <= 0.0 or k >= 1.0
                lg.lns.push(line.new(x1, y, x2, y, color = color.new(color.gray, k < 0 ? 20 : 45), style = k == 0.0 or k == 1.0 ? line.style_solid : line.style_dotted))
            string t = str.tostring(k) + " (" + f_num(y) + ")" + (k == 1.0 ? (lg.fs ? "  Failure Swing" : lg.bear ? "  BSL hunt" : "  SSL hunt") : "")
            label lb = iFibLeft ? label.new(x1, y, t, style = label.style_label_right, color = color.new(color.black, 100), textcolor = color.silver, size = sTxt) : label.new(x2, y, t, style = label.style_label_left, color = color.new(color.black, 100), textcolor = color.silver, size = sTxt)
            lg.lbs.push(lb)
        if iShowBoxes
            lg.bxs.push(box.new(lg.oneBar, f_fib(lg, -iZ1a), x2, f_fib(lg, -iZ1b), border_color = color.new(color.orange, 70), bgcolor = color.new(color.orange, 88), text = (lg.fs ? "FS " : "") + (lg.bear ? "Re-distribution" : "Re-accumulation"), text_size = sBox, text_color = color.orange))
        if iShowBoxes
            lg.bxs.push(box.new(lg.oneBar, f_fib(lg, -iZ2a), x2, f_fib(lg, -iZ2b), border_color = color.new(col, 60), bgcolor = color.new(col, 85), text = (lg.fs ? "FS " : "") + "Retrace / Reversal", text_size = sBox, text_color = col))
        if iShowBoxes
            lg.bxs.push(box.new(lg.oneBar, f_fib(lg, -iZ3a), x2, f_fib(lg, -iZ3b), border_color = color.new(col, 40), bgcolor = color.new(col, 75), text = (lg.fs ? "FS " : "") + "Final Reversal", text_size = sBox, text_color = col))
    lg.lns.size()

f_extendLeg(Leg lg) =>
    int x2 = f_fibEnd(lg)
    if not iFibTv
        for ln in lg.lns
            line.set_x2(ln, x2)
        if not iFibLeft
            for lb in lg.lbs
                label.set_x(lb, x2)
        for bx in lg.bxs
            box.set_right(bx, x2)
    x2

f_deleteLeg(Leg lg) =>
    for ln in lg.lns
        line.delete(ln)
    for lb in lg.lbs
        label.delete(lb)
    for bx in lg.bxs
        box.delete(bx)
    lg.cleaned := true
    lg.cleaned

var array<bool>  zrBear = array.new<bool>()
var array<float> zrOne  = array.new<float>()
var array<float> zrZero = array.new<float>()
var array<int>   zrBar  = array.new<int>()
f_zoneHit(int k, bool newBear, float one, int oneBar) =>
    bool ok = false
    int ob = zrBar.get(k)
    if zrBear.get(k) != newBear and ob < oneBar and oneBar - ob <= iLegAge
        bool zb = zrBear.get(k)
        float o1 = zrOne.get(k)
        float o0 = zrZero.get(k)
        float u = math.abs(o1 - o0)
        float worst = o0
        bool broken = false
        for b = ob + 1 to oneBar
            float cb = close[bar_index - b]
            if zb ? cb > o1 : cb < o1
                broken := true
            worst := zb ? math.min(worst, cb) : math.max(worst, cb)
        if not broken
            float z2a = zb ? o0 - iZ2a * u : o0 + iZ2a * u
            float z2b = zb ? o0 - iZ2b * u : o0 + iZ2b * u
            float z3a = zb ? o0 - iZ3a * u : o0 + iZ3a * u
            float z3b = zb ? o0 - iZ3b * u : o0 + iZ3b * u
            if zb
                ok := (one <= z2a and worst >= z2b) or (one <= z3a and worst >= z3b)
            else
                ok := (one >= z2a and worst <= z2b) or (one >= z3a and worst <= z3b)
    ok

f_inPriorZone(bool newBear, float one, int oneBar) =>
    bool ok = false
    int n = zrBar.size()
    if n > 0
        for k = n - 1 to 0
            if not ok and f_zoneHit(k, newBear, one, oneBar)
                ok := true
    ok

// other side of a hunt setup's dealing range (BSL above an SSL hunt, SSL below a BSL hunt): the opposite stop hunt
// whose -2..-2.5 / -3.5..-4 this hunt reached, else the last opposite stop hunt beyond it; computed once per leg
f_oppHunt(Leg lg) =>
    if not lg.oppDone
        lg.oppDone := true
        float px = na
        int pb = -1
        int n = zrBar.size()
        if n > 0
            for k = n - 1 to 0
                int ob = zrBar.get(k)
                float o1 = zrOne.get(k)
                if na(lg.oppPx) and zrBear.get(k) != lg.bear and ob < lg.oneBar and lg.oneBar - ob <= iLegAge and (lg.bear ? o1 < lg.one : o1 > lg.one)
                    if pb < 0
                        px := o1
                        pb := ob
                    if f_zoneHit(k, lg.bear, lg.one, lg.oneBar)
                        lg.oppPx := o1
                        lg.oppBar := ob
        if na(lg.oppPx)
            lg.oppPx := px
            lg.oppBar := pb
    lg.oppBar

// SDP zones of the leg zero -> one, nearest first: the first one fully in premium (buy) / discount (sell) of the dealing
// range is the target at its first level (-1 / -2 / -3.5); a zone across the 50% makes the 50% the target
f_drTarget(bool buy, float zero, float one, float drEq, float entry) =>
    float t = na
    string why = ""
    string side = buy ? "premium" : "discount"
    for z = 0 to 2
        if na(t)
            float a = z == 0 ? iZ1a : z == 1 ? iZ2a : iZ3a
            float b = z == 0 ? iZ1b : z == 1 ? iZ2b : iZ3b
            float pa = zero - a * (one - zero)
            float pb = zero - b * (one - zero)
            float zLo = math.min(pa, pb)
            float zHi = math.max(pa, pb)
            string zt = "-" + str.tostring(a) + "/-" + str.tostring(b)
            if (buy ? zLo >= drEq : zHi <= drEq) and (buy ? pa > entry : pa < entry)
                t := pa
                why := "-" + str.tostring(a) + ": zone " + zt + " in " + side
            else if zLo < drEq and zHi > drEq and (buy ? drEq > entry : drEq < entry)
                t := drEq
                why := "50% of the dealing range: zone " + zt + " across it"
    if na(t)
        t := drEq
        why := "50% of the dealing range: no SDP zone in " + side
    [t, why]

// main target with the TP buffer and the R cap; legacy = target of the other modes
f_mainTarget(bool buy, float entry, float risk, float zero, float one, float drEq, float legacy, string legacyWhy) =>
    float cap = buy ? entry + iMaxRR * risk : entry - iMaxRR * risk
    float t = na
    string why = ""
    if iTgtMode == TGT_DR and not na(drEq)
        [t0, w0] = f_drTarget(buy, zero, one, drEq, entry)
        if buy ? t0 > cap : t0 < cap
            t := buy ? math.max(cap, drEq) : math.min(cap, drEq)
            why := " (" + (t == cap ? str.tostring(iMaxRR) + "R cap" : "50% of the dealing range") + "; " + w0 + " = " + f_num(t0) + ")"
        else
            t := t0
            why := " (" + w0 + ")"
        t := buy ? t - iTpBuf * PIP : t + iTpBuf * PIP
    else
        t := buy ? legacy - iTpBuf * PIP : legacy + iTpBuf * PIP
        why := (buy ? t > cap : t < cap) ? " (" + str.tostring(iMaxRR) + "R cap; " + legacyWhy + " = " + f_num(t) + ")" : " (" + legacyWhy + ")"
        t := buy ? math.min(t, cap) : math.max(t, cap)
    [t, why]

f_revEq(bool legBear, float one, int oneBar) =>
    float eq = na
    float big = 0.0
    int n = zrBar.size()
    if n > 0
        for k = n - 1 to 0
            int ob = zrBar.get(k)
            float o1 = zrOne.get(k)
            if zrBear.get(k) != legBear and ob < oneBar and oneBar - ob <= iLegAge and (legBear ? o1 < one : o1 > one) and math.abs(o1 - one) > big
                big := math.abs(o1 - one)
                eq := (o1 + one) / 2
    eq

if hunts.size() > 0
    array<Hunt> still = array.new<Hunt>()
    for hu in hunts
        bool back = hu.bear ? close < hu.level : close > hu.level
        if back
            array<Leg> book = hu.bear ? bearLegs : bullLegs
            bool dup = false
            for x in book
                if x.oneBar == hu.bar
                    dup := true
            Leg lg = Leg.new(hu.bear, hu.one, hu.zero, hu.bar, bar_index, hu.names, drOne = hu.one, zeroBar = hu.zeroBar, z5 = Ltf.new(), c5 = Ltf.new(), lns = array.new<line>(), lbs = array.new<label>(), bxs = array.new<box>())
            bool took = false
            if not dup
                lg.inZone := f_inPriorZone(hu.bear, hu.one, hu.bar)
                if iSupersede
                    for x in book
                        if not x.done and not x.fs and x.zone == "" and not x.signaled and x.oneBar < hu.bar and ((hu.bear ? hu.one > x.one : hu.one < x.one) or math.abs(hu.zero - x.zero) <= iEqPips * PIP)
                            took := true
                            lg.inZone := lg.inZone or x.inZone
            if not dup and iChain and not lg.inZone and not hu.external and not took
                dup := true
            if not dup and took
                for x in book
                    if not x.done and not x.fs and x.zone == "" and not x.signaled and x.oneBar < hu.bar and ((hu.bear ? hu.one > x.one : hu.one < x.one) or math.abs(hu.zero - x.zero) <= iEqPips * PIP)
                        x.done := true
                        x.endWhy := "replaced by the last stop hunt"
            if not dup
                if useHZ and not lg.inZone
                    lg.cDone := true
                zrBear.push(hu.bear)
                zrOne.push(hu.one)
                zrZero.push(hu.zero)
                zrBar.push(hu.bar)
                if zrBar.size() > 60
                    zrBear.shift()
                    zrOne.shift()
                    zrZero.shift()
                    zrBar.shift()
                if not iClean
                    f_drawLeg(lg)
                book.push(lg)
                int live = 0
                for x in book
                    if not x.done and not x.fs
                        live += 1
                while live > iMaxLegs
                    int ks = -1
                    float us = na
                    for k = 0 to book.size() - 2
                        Leg x = book.get(k)
                        if not x.done and not x.fs and (na(us) or math.abs(x.one - x.zero) < us)
                            us := math.abs(x.one - x.zero)
                            ks := k
                    if ks < 0
                        break
                    Leg sm = book.get(ks)
                    sm.done := true
                    sm.endWhy := "replaced by bigger legs"
                    live -= 1
        else if bar_index - hu.bar <= 3
            still.push(hu)
    hunts := still
if fsq.size() > 0
    for hu in fsq
        array<Leg> book = hu.bear ? bearLegs : bullLegs
        float pOne = na
        for x in book
            if x.oneBar == hu.parent and not x.fs and not x.done
                pOne := x.one
        if not na(pOne)
            Leg lg = Leg.new(hu.bear, hu.one, hu.zero, hu.bar, bar_index, hu.names, cDone = true, fs = true, parentBar = hu.parent, drOne = pOne, zeroBar = hu.zeroBar, z5 = Ltf.new(), c5 = Ltf.new(), lns = array.new<line>(), lbs = array.new<label>(), bxs = array.new<box>())
            if not iClean
                f_drawLeg(lg)
            book.push(lg)
    fsq.clear()

f_dBiasTxt(bool buy) =>
    string b = dBias == 1 ? "Bullish" : dBias == -1 ? "Bearish" : "Neutral"
    string why = iBiasMode == "Simple" ? "" : dReact != 0 ? " - rejected " + (dReact < 0 ? "bear" : "bull") + " D-FVG" : dDrOk ? " - daily " + (close > dDrEq ? "premium " : "discount ") + str.tostring(math.round(100 * (close - dDrLo) / (dDrHi - dDrLo))) + "% of " + f_num(dDrLo) + "-" + f_num(dDrHi) : ""
    b + why + (dBias == 0 ? "" : (dBias == 1) == buy ? " (with the trade)" : " (against the trade)")
f_drPos(float hi, float lo, float px, bool buy) =>
    string t = "—"
    int ok = 0
    if not na(hi) and not na(lo) and hi > lo
        float eq = (hi + lo) / 2
        bool w = buy ? px < eq : px > eq
        ok := w ? 1 : -1
        t := (px < eq ? "discount " : "premium ") + str.tostring(math.round(100 * (px - lo) / (hi - lo))) + "% (" + (w ? "with" : "against") + ")"
    [t, ok]
f_warn(bool buy, float px) =>
    [t4, o4] = f_drPos(h4DrHi, h4DrLo, px, buy)
    bool bAg = dBias != 0 and (dBias == 1) != buy
    bool rAg = o4 == -1
    bool tAg = iWarnTrend and dTrend != 0 and (dTrend == 1) != buy
    string w = (tAg ? " + against daily trend" : "") + (bAg ? " + against daily bias" : "") + (rAg ? " + wrong side of 4h range" : "")
    w == "" ? "" : "⚠ " + str.substring(w, 3) + " → reduce size"
f_htfTxt(bool buy, float px) =>
    [t4, o4] = f_drPos(h4DrHi, h4DrLo, px, buy)
    [tD, oD] = f_drPos(dDrHi, dDrLo, px, buy)
    "4h: " + t4 + " · D: " + tD
f_htfRej(bool buy, float px) =>
    [t4, o4] = f_drPos(h4DrHi, h4DrLo, px, buy)
    [tD, oD] = f_drPos(dDrHi, dDrLo, px, buy)
    bool known = o4 != 0 or oD != 0
    bool pass = HTFF == "Off" or not known or (HTFF == "4h or daily" ? (o4 == 1 or oD == 1) : (o4 != -1 and oD != -1))
    pass ? "" : "entry against the 4h and daily dealing ranges (" + f_htfTxt(buy, px) + ")"
f_mssMkt(bool gapBull, float eq) =>
    Gap g = na
    if iMssMkt != "Off"
        bool ok = false
        if iMssMkt == "Setup range"
            ok := gapBull ? close < eq : close > eq
        else
            [t4, o4] = f_drPos(h4DrHi, h4DrLo, close, gapBull)
            [tD, oD] = f_drPos(dDrHi, dDrLo, close, gapBull)
            ok := o4 == 1 or oD == 1
        if ok
            g := Gap.new(bar_index, close, close, gapBull, nofvg = true, atMss = true)
    g

f_dFvgTxt(bool buy) =>
    string t = ""
    if not na(dBB) and close >= dBB and close <= dBT
        t := "in bull D-FVG " + f_num(dBB) + "-" + f_num(dBT) + (buy ? " (with the trade)" : " (against the trade)")
    else if not na(dSB) and close >= dSB and close <= dST
        t := "in bear D-FVG " + f_num(dSB) + "-" + f_num(dST) + (buy ? " (against the trade)" : " (with the trade)")
    else if buy
        t := "bull D-FVG below: " + (na(dBB) ? "—" : f_num(dBB) + "-" + f_num(dBT))
    else
        t := "bear D-FVG above: " + (na(dSB) ? "—" : f_num(dSB) + "-" + f_num(dST))
    t

bool ALJSON = iAlFmt == "JSON (webhook bot)"
f_rTxt(float r) => na(r) ? "" : (r > 0 ? "+" : "") + str.tostring(r, "0.00")
f_tm(int t) => str.format_time(t, "HH:mm", "Asia/Tehran") + " Tehran / " + str.format_time(t, "HH:mm", "America/New_York") + " NY"
f_sigTxt(bool buy, string grade, string setupTxt, float entry, bool market, float stop, float partial, float main, float rr, int vb) =>
    int until = time_close + vb * timeframe.in_seconds() * 1000
    (buy ? "🟢 BUY " : "🔴 SELL ") + TK + " " + timeframe.period + "m · grade " + grade + " · " + setupTxt +
     "\nEntry " + (market ? "MARKET ~" : "LIMIT ") + f_num(entry) + " · SL " + f_num(stop) + " · TP " + f_num(main) + (na(partial) ? "" : " (partial " + f_num(partial) + ")") + " · R:R 1:" + str.tostring(rr, "0.0") +
     (market ? "" : "\nValid until " + f_tm(until) + ". Cancel the order if TP " + f_num(na(partial) ? main : partial) + " is reached before the entry.") +
     "\nSignal at " + f_tm(time_close)
f_evTxt(Trade tr, string ev, float px, float r) =>
    string s = (tr.sell ? "SELL " : "BUY ") + TK + " (signal " + tr.id + ")"
    ev == "filled" ? (iOnRetrace ? (tr.sell ? "🔴 SELL " : "🟢 BUY ") + TK + " " + timeframe.period + "m NOW at " + f_num(px) + " (price is back in the FVG)\nSL " + f_num(tr.stop) + " · TP " + f_num(tr.tpMain) + (na(tr.tp1) ? "" : " (partial " + f_num(tr.tp1) + ")") + (tr.warn == "" ? "" : "\n" + tr.warn) + "\nSignal " + tr.id : "✅ " + s + " FILLED at " + f_num(px)) :
     ev == "cancel" ? "❌ " + s + " CANCELLED: target reached before the entry - delete the limit order, do not enter" :
     ev == "expired" ? "⌛ " + s + " EXPIRED: not filled in time - delete the limit order" :
     ev == "tp1" ? "💰 " + s + " PARTIAL hit at " + f_num(px) + " - close " + str.tostring(iPartFrac * 100, "0") + "%, keep the stop" :
     ev == "tp" ? "🎯 " + s + " TARGET hit " + f_num(px) + " · " + f_rTxt(r) + "R" :
     ev == "sl" ? "🛑 " + s + " STOP hit " + f_num(px) + " · " + f_rTxt(r) + "R" :
     ev == "close" ? "📰 " + s + " CLOSED before red news at " + f_num(px) + " · " + f_rTxt(r) + "R" : s + " " + ev
f_sigSdp(float one, float zero, int b1, int b0, bool full, color col, string tag) =>
    int x1 = b0 >= 0 ? math.min(b0, b1) : b1
    int x2 = math.max(math.max(b0, b1), x1 + 2)
    array<float> ks = full ? array.from(1.0, 0.786, 0.705, 0.618, 0.5, 0.0, -1.0, -1.5, -2.0, -2.5) : array.from(1.0, 0.0, -1.0, -2.0, -2.5)
    for k in ks
        float y = zero + k * (one - zero)
        line.new(x1, y, x2, y, color = color.new(col, k == 0.0 or k == 1.0 ? 15 : full ? 40 : 55))
        if full
            label.new(x1, y, str.tostring(k) + " (" + f_num(y) + ")" + (k == 1.0 ? "  " + tag : ""), style = label.style_label_right, color = color.new(color.black, 100), textcolor = col, size = sTxt)
    ks.size()

f_tradeLines(Trade tr, bool full, string tpWhy) =>
    tr.lns := array.new<line>()
    tr.lls := array.new<label>()
    int tA = full ? 0 : 25
    tr.lns.push(line.new(bar_index, tr.entry, bar_index + 1, tr.entry, color = color.new(color.blue, tA), width = full ? 2 : 1))
    tr.lns.push(line.new(bar_index, tr.stop, bar_index + 1, tr.stop, color = color.new(cSell, tA), width = full ? 2 : 1))
    tr.lns.push(line.new(bar_index, tr.tpMain, bar_index + 1, tr.tpMain, color = color.new(cBuy, tA), width = full ? 2 : 1))
    if full and not na(tr.tp1)
        tr.lns.push(line.new(bar_index, tr.tp1, bar_index + 1, tr.tp1, color = color.new(cBuy, 45), style = line.style_dashed))
    string lsz = full ? sSig : sSigOld
    if full or iOldLbl
        tr.lls.push(label.new(bar_index + 1, tr.entry, "Entry " + f_num(tr.entry), style = label.style_label_lower_right, color = color.new(color.black, 100), textcolor = color.new(color.blue, tA), size = lsz))
        tr.lls.push(label.new(bar_index + 1, tr.stop, "SL " + f_num(tr.stop), style = label.style_label_lower_right, color = color.new(color.black, 100), textcolor = color.new(cSell, tA), size = lsz))
        tr.lls.push(label.new(bar_index + 1, tr.tpMain, "TP " + f_num(tr.tpMain) + (full ? tpWhy : ""), style = label.style_label_lower_right, color = color.new(color.black, 100), textcolor = color.new(cBuy, tA), size = lsz))
    if full
        if not na(tr.tp1)
            tr.lls.push(label.new(bar_index + 1, tr.tp1, "Partial " + str.tostring(iPartFrac * 100, "0") + "% " + f_num(tr.tp1), style = label.style_label_lower_right, color = color.new(color.black, 100), textcolor = color.new(cBuy, 20), size = sSig))
    tr.lns.size()
// ICT dealing range of a signal: BSL swing on top, SSL swing at the bottom, premium above the 50%, discount below
f_drawDR(Trade tr, float hi, int hiB, float lo, int loB, bool buy) =>
    tr.bxs := array.new<box>()
    if iShowDR and DRAW and not na(hi) and not na(lo) and hi > lo
        int x1 = math.max(0, bar_index - 1500, hiB >= 0 and loB >= 0 ? math.min(hiB, loB) : math.max(hiB, loB))
        float eq = (hi + lo) / 2
        tr.bxs.push(box.new(x1, hi, bar_index + 1, eq, border_color = color.new(cSell, 65), bgcolor = color.new(cSell, buy ? 93 : 85), text = "Premium · BSL " + f_num(hi), text_size = size.tiny, text_color = cSell, text_halign = text.align_left, text_valign = text.align_top))
        tr.bxs.push(box.new(x1, eq, bar_index + 1, lo, border_color = color.new(cBuy, 65), bgcolor = color.new(cBuy, buy ? 85 : 93), text = "Discount · SSL " + f_num(lo) + " · 50% " + f_num(eq), text_size = size.tiny, text_color = cBuy, text_halign = text.align_left, text_valign = text.align_bottom))
    tr.bxs.size()
f_extendLines(Trade tr) =>
    if not na(tr.lns)
        int xe = math.min(bar_index, tr.lns.size() > 0 ? line.get_x1(tr.lns.get(0)) + iLineBars : bar_index)
        for ln in tr.lns
            line.set_x2(ln, xe)
        for lb in tr.lls
            label.set_x(lb, xe)
        if not na(tr.bxs)
            for bx in tr.bxs
                box.set_right(bx, math.max(xe, box.get_left(bx) + 1))
    tr.state
f_endLines(Trade tr, string ev) =>
    if not na(tr.lns) and (ev == "cancel" or ev == "expired")
        bool drop = (tr.mini and not iOldCanc) or iOnRetrace
        for ln in tr.lns
            if drop
                line.delete(ln)
            else
                line.set_color(ln, color.new(color.gray, 50))
                line.set_style(ln, line.style_dotted)
        for lb in tr.lls
            if drop
                label.delete(lb)
            else
                label.set_textcolor(lb, color.new(color.gray, 30))
        if not na(tr.bxs)
            for bx in tr.bxs
                if drop
                    box.delete(bx)
                else
                    box.set_bgcolor(bx, color.new(color.gray, 92))
                    box.set_border_color(bx, color.new(color.gray, 70))
                    box.set_text_color(bx, color.new(color.gray, 30))
    if not na(tr.lns) and ev == "filled" and tr.lns.size() > 0
        line.set_y1(tr.lns.get(0), tr.entry)
        line.set_y2(tr.lns.get(0), tr.entry)
    tr.state

f_markBox(Trade tr, string ev, float r) =>
    if not na(tr.lab) and iOnRetrace and (ev == "cancel" or ev == "expired")
        label.delete(tr.lab)  // the price never came back to the FVG: no signal
    else if not na(tr.lab) and tr.mini
        string arrow = tr.sell ? "▼" : "▲"
        if ev == "cancel" or ev == "expired"
            if iOldCanc
                label.set_text(tr.lab, arrow + " " + tr.kind + (ev == "cancel" ? " ✕" : " ⌛"))
                label.set_textcolor(tr.lab, color.new(color.gray, 20))
                label.set_tooltip(tr.lab, (ev == "cancel" ? "CANCELLED - TP before entry\n" : "EXPIRED - not filled\n") + tr.tip)
            else
                label.delete(tr.lab)
        else if ev == "tp" or ev == "sl" or ev == "close"
            label.set_text(tr.lab, arrow + " " + tr.kind + " " + f_rTxt(r) + "R")
            label.set_textcolor(tr.lab, r > 0.05 ? cBuy : r < -0.05 ? cSell : color.gray)
            label.set_tooltip(tr.lab, (ev == "tp" ? "TP " : ev == "sl" ? "SL " : "closed (news) ") + f_rTxt(r) + "R\n" + tr.tip)
    else if not na(tr.lab)
        string tag = ev == "cancel" ? "❌ CANCELLED - TP before entry, do not enter" : ev == "expired" ? "⌛ EXPIRED - not filled, do not enter" : ev == "filled" ? "✅ FILLED" : ev == "tp" ? "🎯 TP " + f_rTxt(r) + "R" : ev == "sl" ? "🛑 SL " + f_rTxt(r) + "R" : ev == "close" ? "📰 closed (news) " + f_rTxt(r) + "R" : ""
        if tag != ""
            string body = label.get_text(tr.lab)
            if str.startswith(body, "✅ FILLED\n")
                body := str.substring(body, str.length("✅ FILLED\n"))
            if str.startswith(body, "⏳ waiting for the FVG\n")
                body := str.substring(body, str.length("⏳ waiting for the FVG\n"))
            label.set_text(tr.lab, tag + "\n" + body)
            if ev == "cancel" or ev == "expired"
                label.set_color(tr.lab, color.new(color.gray, 55))
                label.set_textcolor(tr.lab, color.new(color.white, 30))
    tr.state
f_update(Trade tr, string ev, float px, float r) =>
    f_markBox(tr, ev, r)
    f_endLines(tr, ev)
    bool quiet = iOnRetrace and (ev == "cancel" or ev == "expired")  // never announced -> nothing to cancel
    if (iAlUpdates or (iOnRetrace and ev == "filled")) and not ALJSON and not quiet
        alert(f_evTxt(tr, ev, px, r), alert.freq_once_per_bar_close)
    if iAlUpdates and ALJSON
        string js = "{\"passphrase\":" + f_q(iPass) + ",\"type\":\"update\",\"id\":" + f_q(tr.id) + ",\"symbol\":" + f_q(TK) + ",\"event\":" + f_q(ev) + ",\"price\":" + f_num(px) + ",\"r\":" + (na(r) ? "null" : str.tostring(r, "0.00")) + "}"
        alert(js, alert.freq_once_per_bar_close)
    ev

f_close(Trade tr, string ev, float px) =>
    tr.realized += tr.remaining * (tr.sell ? tr.entry - px : px - tr.entry)
    tr.remaining := 0.0
    tr.state := 2
    float r = tr.realized / tr.risk
    st.closed += 1
    st.totalR += r
    if r > 0.05
        st.wins += 1
    else if r < -0.05
        st.losses += 1
    f_update(tr, ev, px, r)

f_manage(Trade tr, bool fillBar) =>
    if not fillBar and iNewsClose and f_newsAt(time) != ""
        f_close(tr, "close", open)
    if tr.state == 1
        if tr.sell ? high >= tr.stop : low <= tr.stop
            f_close(tr, "sl", tr.stop)
    if tr.state == 1 and not fillBar
        if not tr.partialDone and not na(tr.tp1) and (tr.sell ? low <= tr.tp1 : high >= tr.tp1)
            tr.realized += iPartFrac * (tr.sell ? tr.entry - tr.tp1 : tr.tp1 - tr.entry)
            tr.remaining -= iPartFrac
            tr.partialDone := true
            if tr.remaining <= 0.000001  // partial size 1: the whole position closes here
                f_close(tr, "tp", tr.tp1)
            else
                f_update(tr, "tp1", tr.tp1, na)
        if tr.state == 1 and (tr.sell ? low <= tr.tpMain : high >= tr.tpMain)
            f_close(tr, "tp", tr.tpMain)
    tr.state

if trades.size() > 0
    for i = trades.size() - 1 to 0
        Trade tr = trades.get(i)
        f_extendLines(tr)
        if tr.state == 0
            float firstTp = na(tr.tp1) ? tr.tpMain : tr.tp1
            if bar_index > tr.validUntil
                tr.state := 2
                f_update(tr, "expired", na, na)
            else if tr.market or (tr.sell ? high >= tr.entry : low <= tr.entry)
                if tr.market
                    tr.entry := open
                tr.risk := math.abs(tr.entry - tr.stop)
                if tr.risk <= 0 or (tr.sell ? tr.entry >= tr.stop : tr.entry <= tr.stop)  // market fill opened beyond the stop
                    tr.state := 2
                else
                    tr.state := 1
                    f_update(tr, "filled", tr.entry, na)
                    if iShowFvg and (DRAW or not iOldSig)
                        float aE = na(atr14) ? 0.0 : atr14 * 0.2
                        label.new(bar_index, tr.sell ? high + aE : low - aE, tr.sell ? "SELL\n▼" : "BUY\n▲", style = tr.sell ? label.style_label_down : label.style_label_up, color = color.new(color.black, 100), textcolor = tr.sell ? cSell : cBuy, size = sSig)
                    f_manage(tr, true)
            else if tr.sell ? low <= firstTp : high >= firstTp
                tr.state := 2
                f_update(tr, "cancel", na, na)
        else if tr.state == 1
            f_manage(tr, false)
        if tr.state == 2
            if tr.legBar == st.liveLeg
                st.liveLeg := -1
            trades.remove(i)

int w1s = f_sStart(sW1)
int w1e = f_sEnd(sW1)
int w2s = f_sStart(sW2)
int w2e = f_sEnd(sW2)
int w3s = f_sStart(sW3)
int w3e = f_sEnd(sW3)
int w4s = f_sStart(sW4)
int w4e = f_sEnd(sW4)
string winReal = iW1 and f_in(mod, w1s, w1e) ? "london" : iW2 and f_in(mod, w2s, w2e) ? "ny_am" : iW3 and f_in(mod, w3s, w3e) ? "silver_bullet_am" : iW4 and f_in(mod, w4s, w4e) ? "silver_bullet_pm" : ""
bool inSB = f_in(mod, f_sStart(sSB1), f_sEnd(sSB1)) or f_in(mod, f_sStart(sSB2), f_sEnd(sSB2)) or f_in(mod, f_sStart(sSB3), f_sEnd(sSB3))
string winNow = winReal != "" ? winReal : iUseWin ? "" : "any_time"
bgcolor(iShowWin and winReal != "" ? color.new(color.gray, 92) : na, title = "Trade window")

var array<label> noteLbs = array.new<label>()
f_grayNote(bool buySide, string txt) =>
    bool dupNote = buySide ? (txt == st.noteTxtDn and bar_index - st.noteTxtDnBar <= 16) : (txt == st.noteTxtUp and bar_index - st.noteTxtUpBar <= 16)
    if buySide
        st.noteTxtDn := txt
        st.noteTxtDnBar := bar_index
    else
        st.noteTxtUp := txt
        st.noteTxtUpBar := bar_index
    float a = na(atr14) ? 0.0 : atr14
    int slot = 0
    if buySide
        slot := bar_index - st.noteBarDn <= 12 ? (st.noteSlotDn + 1) % 4 : 0
        st.noteBarDn := bar_index
        st.noteSlotDn := slot
    else
        slot := bar_index - st.noteBarUp <= 12 ? (st.noteSlotUp + 1) % 4 : 0
        st.noteBarUp := bar_index
        st.noteSlotUp := slot
    float y = buySide ? rngLo - a * (0.6 + 0.9 * slot) : rngHi + a * (0.6 + 0.9 * slot)
    label lb = na
    if not dupNote and DRAW
        lb := label.new(bar_index, y, (str.contains(txt, "✓") or str.contains(txt, "✕") ? "" : "✕ ") + txt, style = buySide ? label.style_label_up : label.style_label_down, color = color.new(color.gray, 60), textcolor = color.white, size = sNote, tooltip = txt)
        noteLbs.push(lb)
        if iNotesN > 0 and noteLbs.size() > iNotesN
            label.delete(noteLbs.shift())
    lb

f_reject(Leg lg, string why) =>
    st.rejected += 1
    if iShowRej
        f_grayNote(lg.bear, why)
    why

f_note(Leg lg, bool buySide, string why) =>
    if iShowRej and lg.note != why
        lg.note := why
        f_grayNote(buySide, why)
    why

f_touch(Leg lg, string z, float ext) =>
    lg.zone := z
    lg.touchBar := bar_index
    lg.extreme := ext
    lg.extremeBar := bar_index
    lg.mssBar := -1
    lg.mssLevel := na
    lg.ithBar := -1
    lg.z5 := Ltf.new()
    z

f_resetSetup(Leg lg) =>
    lg.zone := ""
    lg.touchBar := -1
    lg.extreme := na
    lg.extremeBar := -1
    lg.mssBar := -1
    lg.mssLevel := na
    lg.ithBar := -1
    lg.z5 := Ltf.new()
    lg.zone

// walk the lower-timeframe candles not seen yet, in order (the first time: from chart bar fromBar on). A new extreme resets
// the MSS and, when needHunt, must take an LTF swing (stop hunt); a later candle beyond the LTF swing before the extreme is
// the MSS (short-term swing or ITH/ITL, like "MSS must break"). True when this walk ends with an MSS after the last extreme.
f_track5(Ltf t, bool buy, int fromBar, bool needHunt, int fbBar) =>
    bool hit = false
    int s = x5h.size()
    if LTF_MSS and s > 0
        int base = n5 - s
        int p0 = t.last + 1 - base
        if t.xi < 0
            p0 := s
            while p0 > 0 and x5b.get(p0 - 1) >= fromBar
                p0 -= 1
        p0 := math.max(0, p0)
        int win = iIthLB * LTF_N
        array<int> hb = buy ? s5lI : s5hI
        array<float> hp = buy ? s5lP : s5hP
        array<int> pb = MSS_SHORT ? (buy ? s5hI : s5lI) : (buy ? i5hI : i5lI)
        array<float> pp = MSS_SHORT ? (buy ? s5hP : s5lP) : (buy ? i5hP : i5lP)
        if p0 <= s - 1
            for p = p0 to s - 1
                int gi = base + p
                float h = x5h.get(p)
                float l = x5l.get(p)
                if t.xi < 0 or (buy ? l < t.xp : h > t.xp)
                    t.xi := gi
                    t.xp := buy ? l : h
                    t.xt := x5t.get(p)
                    t.hunt := not needHunt
                    hit := false
                    int nh = hb.size()
                    if needHunt and nh > 0
                        for k = nh - 1 to 0
                            int b = hb.get(k)
                            if b < gi
                                t.hunt := b >= gi - win and (buy ? hp.get(k) > l : hp.get(k) < h)
                                break
                else if t.hunt and not hit
                    int n = pb.size()
                    if n > 0
                        for k = n - 1 to 0
                            int b = pb.get(k)
                            if b < t.xi
                                float pk = pp.get(k)
                                if b >= t.xi - win and (buy ? h > pk : l < pk)
                                    hit := true
                                    int pos = f_p5(b)
                                    t.zero := pk
                                    t.zeroBar := pos >= 0 ? x5b.get(pos) : fbBar
                                break
        t.last := n5 - 1
    hit

// displacement on the lower timeframe: a candle from the LTF extreme on with body >= 50% of its range and range >= ATR x
f_disp5(bool buy, int fromI) =>
    bool d = false
    int s = x5h.size()
    int p0 = math.max(0, f_p5(fromI) + (iDispHunt ? 0 : 1))
    if s > 0 and p0 <= s - 1
        for p = p0 to s - 1
            float rng = x5h.get(p) - x5l.get(p)
            float body = buy ? x5c.get(p) - x5o.get(p) : x5o.get(p) - x5c.get(p)
            float a = x5a.get(p)
            if rng > 0 and body >= 0.5 * rng and (na(a) or rng >= iDispAtr * a)
                d := true
                break
    d

f_3pd(Leg lg) =>
    bool bear = lg.bear
    int x = lg.extremeBar
    int a0 = math.max(0, lg.ithBar)
    int ox = bar_index - x
    int cnt = 1
    float lvl = f_cisdAt(ox, not bear)
    bool cisdFail = false
    if ox >= 1
        for k = 0 to ox - 1
            if bear ? close[k] > lvl : close[k] < lvl
                cisdFail := true
                break
    cnt += cisdFail ? 1 : 0
    bool fvgFail = false
    int gs = gaps.size()
    if gs > 0
        for idx = 0 to gs - 1
            Gap g = gaps.get(idx)
            if g.bar >= a0 and g.bar <= x and g.bull != bear
                int og = bar_index - g.bar
                if og >= 1
                    for k = 0 to og - 1
                        if bear ? close[k] > g.top : close[k] < g.bottom
                            fvgFail := true
                            break
                if fvgFail
                    break
    cnt += fvgFail ? 1 : 0
    int bestO = -1
    float bestW = 0.0
    for oi = bar_index - a0 to ox
        float rng = high[oi] - low[oi]
        float wk = bear ? high[oi] - math.max(open[oi], close[oi]) : math.min(open[oi], close[oi]) - low[oi]
        if rng > 0 and wk >= 0.5 * rng and wk > bestW
            bestO := oi
            bestW := wk
    bool wickFail = false
    if bestO >= 1
        float mid = bear ? high[bestO] - bestW / 2 : low[bestO] + bestW / 2
        for k = 0 to bestO - 1
            if bear ? close[k] > mid : close[k] < mid
                wickFail := true
                break
    cnt += wickFail ? 1 : 0
    cnt

f_smt(Leg lg) =>
    bool bear = lg.bear
    int b0 = f_lastBarBefore(bear ? slB : shB, lg.touchBar)
    bool res = false
    if b0 >= 0
        bool useLow = bear != iSmtInv
        float ref = na
        float now = na
        for b = math.max(0, b0 - 1) to math.min(bar_index, b0 + 1)
            float v = useLow ? smtL[bar_index - b] : smtH[bar_index - b]
            if not na(v)
                ref := na(ref) ? v : useLow ? math.min(ref, v) : math.max(ref, v)
        for b = lg.touchBar to lg.extremeBar
            float v = useLow ? smtL[bar_index - b] : smtH[bar_index - b]
            if not na(v)
                now := na(now) ? v : useLow ? math.min(now, v) : math.max(now, v)
        res := not na(ref) and not na(now) and (useLow ? now >= ref : now <= ref)
    res

f_signal(Leg lg, Gap g, string win, float drHi, int drHiB, float drLo, int drLoB) =>
    bool buy = lg.bear
    string side = buy ? "buy" : "sell"
    string rej = ""
    float entry = iEdge == "Proximal" ? (buy ? g.top : g.bottom) : (g.top + g.bottom) / 2
    bool market = false
    if (buy ? close <= entry : close >= entry) or (iMktEntry and not iOnRetrace)
        entry := close
        market := true
    float stop = buy ? lg.extreme - iSlPips * PIP : lg.extreme + iSlPips * PIP
    float drEq = (drHi + drLo) / 2
    if (useDR or (iMktEntry and not iOnRetrace)) and (buy ? entry >= drEq : entry <= drEq)
        rej := "entry in " + (buy ? "premium" : "discount") + " of the dealing range (50% = " + f_num(drEq) + ")"
    if rej == "" and ((iRevDR and not lg.fs) or (iMktEntry and not iOnRetrace))
        float rEq = f_revEq(lg.bear, lg.one, lg.oneBar)
        if not na(rEq) and (buy ? entry > rEq : entry < rEq)
            rej := "zone in " + (buy ? "premium" : "discount") + " of the move it retraces (50% = " + f_num(rEq) + ")"
    if rej == ""
        rej := f_htfRej(buy, entry)
    if rej == "" and not TFOK
        rej := "chart is " + timeframe.period + "m - signals only on 15m (setting)"
    if rej == "" and iOneSwing and usedStops.includes(math.round(stop / PIP * 10) * (buy ? 1 : -1))
        rej := "this stop-hunt swing already gave a trade (one trade per swing)"
    float risk = buy ? entry - stop : stop - entry
    if risk <= 0
        rej := "invalid risk"
    else if iUseMinStop and risk < iMinStop * PIP
        rej := "stop too tight (" + str.tostring(risk / PIP, "0.0") + " pips)"
    // entry leg: zone extreme (fib 1) to the swing before it (fib 0) - on the lower timeframe when the MSS came from there
    float tz = lg.z5.mss ? lg.z5.zero : f_lastBefore(buy ? shB : slB, buy ? shP : slP, lg.extremeBar)
    int tzB = lg.z5.mss ? lg.z5.zeroBar : f_lastBarBefore(buy ? shB : slB, lg.extremeBar)
    if rej == "" and na(tz)
        rej := "no swing for the entry leg"
    float unit = na(tz) ? na : buy ? tz - lg.extreme : lg.extreme - tz
    if rej == "" and unit <= 0
        rej := "entry leg invalid"
    float main = na
    float partial = na
    float rr = 0.0
    string tpWhy = ""
    bool extMode = iTgtMode == "External liquidity"
    if rej == ""
        [m0, w0] = f_mainTarget(buy, entry, risk, tz, lg.extreme, drEq, extMode ? lg.drOne : buy ? tz + iTgt * unit : tz - iTgt * unit, extMode ? "fib 1 of the hunt leg" : "-" + str.tostring(iTgt))
        main := m0
        tpWhy := w0
        if buy ? main <= entry : main >= entry
            rej := "target not beyond entry"
        partial := extMode ? drEq : buy ? tz + iPart * unit : tz - iPart * unit
        partial := buy ? partial - iTpBuf * PIP : partial + iTpBuf * PIP
        if not (buy ? (entry < partial and partial < main) : (main < partial and partial < entry))
            partial := na
        rr := (buy ? main - entry : entry - main) / risk
        if rej == "" and iMinRR > 0 and rr < iMinRR
            rej := "R:R 1:" + str.tostring(rr, "0.0") + " below the minimum 1:" + str.tostring(iMinRR, "0.0") + tpWhy
    string warn = ""
    if rej == "" and MOF and not na(midOpen) and (buy ? entry >= midOpen : entry <= midOpen)
        if STRICT or iMOHard
            rej := "wrong side of NY Open"
        else
            warn += "wrong side of NY Open; "
    string eqLeft = ""
    if rej == "" and iUB
        float farPx = buy ? stop - iUBPips * PIP : stop + iUBPips * PIP
        string eqName = buy ? "Equal Lows" : "Equal Highs"
        for l in levels
            bool near = l.bsl != buy and (buy ? l.price >= farPx and l.price <= entry : l.price <= farPx and l.price >= entry)
            if near and (l.kind == "session" or l.kind == "day" or l.kind == "week") and warn == ""
                if STRICT
                    rej := "unfinished business: " + l.name + " " + f_num(l.price) + " not taken"
                    break
                else
                    warn += "unfinished business: " + l.name + " " + f_num(l.price) + "; "
            if near and l.name == eqName and eqLeft == ""
                eqLeft := l.name + " " + f_num(l.price)
        if rej == "" and eqLeft != "" and iUBEq and STRICT
            rej := "unfinished business: " + eqLeft + " not taken"
    if rej == "" and iHtfReq and htfTrend != (buy ? 1 : -1)
        rej := "against higher timeframe"
    if rej == ""
        string nws = iUseNews ? f_newsAt(time_close) : ""
        if nws != ""
            rej := "news: " + nws
    bool emitted = false
    if rej != ""
        f_reject(lg, rej)
    else
        int nPD = iUse3PD ? f_3pd(lg) : 0
        bool pd3 = iUse3PD and nPD >= 3
        bool htfOk = iUseHTF and htfTrend == (buy ? 1 : -1)
        bool smtOk = iUseSMT and f_smt(lg)
        bool sbOk = iUseSB and inSB
        bool dblOk = f_lastBarBefore(buy ? slB : shB, bar_index) > lg.mssBar
        int maxScore = 2 + (iUseSB ? 1 : 0) + (iUse3PD ? 1 : 0) + (iUseHTF ? 1 : 0) + (iUseSMT ? 1 : 0)
        int score = (pd3 ? 1 : 0) + (htfOk ? 1 : 0) + (sbOk ? 1 : 0) + (smtOk ? 1 : 0) + (lg.tsoup ? 1 : 0) + (dblOk ? 1 : 0)
        string grade = score >= 3 ? "A+" : score >= 1 ? "A" : "B"
        if eqLeft != "" or warn != ""
            grade := "B"
        emitted := true
        lg.signaled := true
        st.dayCount += 1
        st.signals += 1
        string id = TK + "-" + timeframe.period + "-" + side + "-" + str.format_time(time_close, "yyyyMMddHHmm", "UTC")
        Trade trNew = Trade.new(id, not buy, entry, stop, partial, main, bar_index + validBars, market, legBar = lg.oneBar)
        trNew.warn := f_warn(buy, entry)
        trades.push(trNew)
        usedStops.push(math.round(stop / PIP * 10) * (buy ? 1 : -1))
        if usedStops.size() > 50
            usedStops.shift()
        st.liveLeg := lg.oneBar
        string zoneTxt = lg.zone == "Z2" ? "-" + str.tostring(iZ2a) + "/-" + str.tostring(iZ2b) : "-" + str.tostring(iZ3a) + "/-" + str.tostring(iZ3b)
        string ltfTxt = lg.z5.mss ? " · stop hunt + MSS " + iLtfTf + "m" : ""
        if iShowTrade
            color col = buy ? cBuy : cSell
            int x2 = bar_index + iLineBars
            f_tradeLines(trNew, DRAW or not iOldSig, tpWhy)
            f_drawDR(trNew, drHi, drHiB, drLo, drLoB, buy)
            f_drawFvg(g, buy)
            if not na(tz)
                f_sigSdp(lg.extreme, tz, lg.extremeBar, tzB, DRAW, col, lg.z5.mss ? "entry leg " + iLtfTf + "m" : "entry leg")
            string txt = (buy ? "BUY " : "SELL ") + grade + " (" + str.tostring(score) + "/" + str.tostring(maxScore) + ")\nZone " + zoneTxt + (lg.fs ? " (Failure Swing)" : "") + ltfTxt + "\nEntry " + f_num(entry) + "\nSL " + f_num(stop) + "\nTP " + f_num(main) + tpWhy + "\nR:R 1:" + str.tostring(rr, "0.0") + "\nDealing range " + f_num(drLo) + " - " + f_num(drHi) + " · 50% " + f_num(drEq) + "\nDaily bias: " + f_dBiasTxt(buy) + "\n" + f_htfTxt(buy, entry) + "\n" + f_dFvgTxt(buy)
            float aB = na(atr14) ? 0.0 : atr14
            string shortTxt = (buy ? "BUY " : "SELL ") + grade + (lg.fs ? " · Failure Swing" : "") + (lg.z5.mss ? " · " + iLtfTf + "m" : "") + " · R:R 1:" + str.tostring(rr, "0.0") + "\nEntry " + f_num(entry) + (market ? " (mkt)" : "") + "\nSL " + f_num(stop) + "  TP " + f_num(main)
            txt := (trNew.warn == "" ? "" : trNew.warn + "\n") + txt
            shortTxt := (trNew.warn == "" ? "" : "⚠ REDUCE SIZE\n") + shortTxt
            trNew.tip := txt
            if DRAW or not iOldSig
                label lb = label.new(bar_index, buy ? math.min(rngLo, stop) - aB : math.max(rngHi, stop) + aB, (iOnRetrace ? "⏳ waiting for the FVG\n" : "") + (iCompact ? shortTxt : txt), style = buy ? label.style_label_up : label.style_label_down, color = col, textcolor = color.white, size = sSig, tooltip = txt)
                trNew.lab := lb
            else
                trNew.mini := true
                trNew.kind := (lg.fs ? "FS" : lg.zone == "Z2" ? "zone -2" : "zone -3.5") + (lg.z5.mss ? " " + iLtfTf + "m" : "")
                trNew.lab := label.new(bar_index, buy ? low - 0.3 * aB : high + 0.3 * aB, (buy ? "▲ " : "▼ ") + (trNew.warn == "" ? "" : "⚠") + trNew.kind, style = buy ? label.style_label_up : label.style_label_down, color = color.new(color.black, 100), textcolor = color.new(col, 10), size = sSig, tooltip = txt)
        if f_gradeRank(grade) >= f_gradeRank(iMinGrade) and not ALJSON and not iOnRetrace
            alert(f_sigTxt(buy, grade, "reversal at the " + zoneTxt + " zone" + (lg.fs ? " (failure swing)" : "") + ltfTxt, entry, market, stop, partial, main, rr, validBars) + (trNew.warn == "" ? "" : "\n" + trNew.warn), alert.freq_once_per_bar_close)
        if f_gradeRank(grade) >= f_gradeRank(iMinGrade) and ALJSON
            string names = ""
            for nm in str.split(lg.names, ",")
                names += (names == "" ? "" : ",") + f_q(nm)
            float t1 = buy ? tz + 1.0 * unit : tz - 1.0 * unit
            float t15 = buy ? tz + 1.5 * unit : tz - 1.5 * unit
            float t2 = buy ? tz + 2.0 * unit : tz - 2.0 * unit
            float t25 = buy ? tz + 2.5 * unit : tz - 2.5 * unit
            string tg = "[{\"sd\":-1,\"price\":" + f_num(t1) + "},{\"sd\":-1.5,\"price\":" + f_num(t15) + "},{\"sd\":-2,\"price\":" + f_num(t2) + "},{\"sd\":-2.5,\"price\":" + f_num(t25) + "}]"
            string cf = "{\"daily_bias\":" + f_q(f_dBiasTxt(buy)) + ",\"htf_ranges\":" + f_q(f_htfTxt(buy, entry)) + ",\"daily_fvg\":" + f_q(f_dFvgTxt(buy)) + ",\"3pd_failed\":" + str.tostring(nPD) + ",\"3pd\":" + f_b(pd3) + ",\"htf\":" + f_b(htfOk) + ",\"smt\":" + f_b(smtOk) + ",\"turtle_soup\":" + f_b(lg.tsoup) + (iUseSB ? ",\"silver_bullet\":" + f_b(inSB) : "") + (eqLeft != "" ? ",\"unfinished_eq\":" + f_q(eqLeft) : "") + (warn != "" ? ",\"warnings\":[" + f_q(warn) + "]" : "") + "}"
            string js = "{\"passphrase\":" + f_q(iPass) + ",\"type\":\"signal\",\"id\":" + f_q(id) + ",\"symbol\":" + f_q(TK) + ",\"exchange\":" + f_q(syminfo.prefix) + ",\"timeframe\":" + f_q(timeframe.period) + ",\"side\":" + f_q(side) + ",\"time\":" + f_q(str.format_time(time_close, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC")) + ",\"killzone\":" + f_q(win) + ",\"entry\":" + f_num(entry) + ",\"stop\":" + f_num(stop) + ",\"entry_type\":" + f_q(market ? "market" : "limit") + ",\"targets\":" + tg + ",\"main_target\":" + f_num(main) + ",\"partial_target\":" + f_num(partial) + ",\"rr\":" + str.tostring(rr, "0.00") + ",\"zone\":" + f_q(zoneTxt) + ",\"sdp_one\":" + f_num(lg.one) + ",\"sdp_zero\":" + f_num(lg.zero) + ",\"leg_one\":" + f_num(lg.extreme) + ",\"leg_zero\":" + f_num(tz) + ",\"mss_level\":" + f_num(lg.mssLevel) + ",\"fvg_top\":" + f_num(g.top) + ",\"fvg_bottom\":" + f_num(g.bottom) + ",\"swept\":[" + names + "],\"setup\":" + f_q(lg.fs ? "failure_swing" : "reversal") + ",\"mss_tf\":" + f_q(lg.z5.mss ? iLtfTf : timeframe.period) + ",\"midnight_open\":" + f_num(midOpen) + ",\"dr_high\":" + f_num(drHi) + ",\"dr_low\":" + f_num(drLo) + ",\"dr_eq\":" + f_num(drEq) + ",\"confirmations\":" + cf + ",\"score\":" + str.tostring(score) + ",\"max_score\":" + str.tostring(maxScore) + ",\"grade\":" + f_q(grade) + "}"
            alert(js, alert.freq_once_per_bar_close)
    emitted

f_stepLeg(Leg lg) =>
    bool out = false
    bool bear = lg.bear
    float ext = bear ? low : high
    bool go = true
    if bear ? close > lg.one : close < lg.one
        lg.done := true
        lg.endWhy := "closed beyond fib 1"
        go := false
    if go and lg.z2Alive
        bool cb = f_beyond(bear, close, f_lvl(lg, iZ2b))
        bool kill = false
        if iZ2Grace and lg.z2Pend >= 0 and bar_index > lg.z2Pend
            lg.z2Pend := -1
            kill := cb
        else if cb
            if iZ2Grace
                lg.z2Pend := bar_index
            else
                kill := true
        if kill
            lg.z2Alive := false
            if lg.zone == "Z2"
                f_resetSetup(lg)
    if go and lg.z3Alive and f_beyond(bear, close, f_lvl(lg, iZ3b))
        lg.z3Alive := false
        lg.done := true
        lg.endWhy := "closed beyond -4, redraw"
        go := false
    if go and lg.zone == ""
        if lg.z2Alive and f_reach(bear, ext, f_lvl(lg, iZ2a))
            f_touch(lg, "Z2", ext)
        else if not lg.z2Alive and lg.z3Alive and f_reach(bear, ext, f_lvl(lg, iZ3a))
            f_touch(lg, "Z3", ext)
        if lg.zone == ""
            go := false
    if go and (bear ? low < lg.extreme : high > lg.extreme)
        lg.extreme := ext
        lg.extremeBar := bar_index
        lg.mssBar := -1
        lg.mssLevel := na
        lg.ithBar := -1
        lg.z5.mss := false
    if go and lg.extremeBar == bar_index
        for sw in sweptNow
            if sw.bsl != bear
                lg.tsoup := true
    if go and lg.mssBar < 0
        bool m5 = false
        if LTF_MSS
            m5 := f_track5(lg.z5, bear, lg.touchBar, true, lg.extremeBar)
        int bI = -1
        float pI = na
        bool m15 = false
        if bar_index > lg.extremeBar
            array<int> pb = MSS_SHORT ? (bear ? shB : slB) : (bear ? ithB : itlB)
            array<float> pp = MSS_SHORT ? (bear ? shP : slP) : (bear ? ithP : itlP)
            int n = pb.size()
            if n > 0
                for k = n - 1 to 0
                    int b = pb.get(k)
                    if b < lg.extremeBar
                        if b >= lg.extremeBar - iIthLB
                            bI := b
                            pI := pp.get(k)
                        break
            m15 := bI >= 0 and (bear ? high > pI : low < pI)
        if not m15 and m5  // the chart timeframe first; the lower one only when it shows no MSS (notes: 15m main, 5m when 15m has no clear leg)
            bI := lg.z5.zeroBar
            pI := lg.z5.zero
        if m15 or m5
            lg.mssBar := bar_index
            lg.mssLevel := pI
            lg.ithBar := bI
            lg.z5.mss := not m15
            float drMid = (lg.extreme + lg.drOne) / 2
            if useDR and (bear ? pI > drMid : pI < drMid)
                f_reject(lg, bear ? "MSS in premium of dealing range (turtle soup)" : "MSS in discount of dealing range (turtle soup)")
                lg.done := true
                lg.endWhy := "fake MSS (turtle soup)"
                go := false
            else
                f_drawMss(bI, pI, lg.z5.mss ? "MSS " + iLtfTf + "m" : "MSS")
        else
            go := false
    if go and iDisp
        bool disp = false
        int ob = bar_index - lg.extremeBar
        if ob >= 1
            for k = 0 to ob - (iDispHunt ? 0 : 1)
                float rng = high[k] - low[k]
                float body = bear ? close[k] - open[k] : open[k] - close[k]
                if rng > 0 and body >= 0.5 * rng and (na(atr14[k]) or rng >= iDispAtr * atr14[k])
                    disp := true
                    break
        if not disp and lg.z5.mss
            disp := f_disp5(bear, lg.z5.xi)
        if not disp
            f_note(lg, bear, "MSS without displacement (candle >= " + str.tostring(iDispAtr) + " ATR) - no signal yet")
        go := disp
    if go
        int ox = bar_index - lg.extremeBar
        float far = bear ? high : low
        int farBar = bar_index
        for k = 0 to ox
            if bear ? high[k] >= far : low[k] <= far
                far := bear ? high[k] : low[k]
                farBar := bar_index - k
        int dispEnd = iFvgDisp ? farBar : bar_index
        // dealing range: BSL = the hunt of the SDP (fib 1), SSL = the zone extreme (mirror for a sell); wider if price went past fib 1
        int oneB = lg.fs ? lg.parentBar : lg.oneBar
        bool farOut = bear ? far > lg.drOne : far < lg.drOne
        float drHi = bear ? (farOut ? far : lg.drOne) : lg.extreme
        int drHiB = bear ? (farOut ? farBar : oneB) : lg.extremeBar
        float drLo = bear ? lg.extreme : (farOut ? far : lg.drOne)
        int drLoB = bear ? lg.extremeBar : (farOut ? farBar : oneB)
        float drEq = (drHi + drLo) / 2
        float eq = (lg.extreme + far) / 2
        if useDR
            eq := bear ? math.min(eq, drEq) : math.max(eq, drEq)
        Gap best = lg.mssBar == bar_index ? f_mssMkt(bear, eq) : na
        int gs = na(best) ? gaps.size() : 0
        if gs > 0
            for idx = math.max(0, gs - 60) to gs - 1
                Gap g = gaps.get(idx)
                if g.bar - (iDispHunt ? 1 : 2) >= lg.extremeBar and g.bar <= dispEnd and not g.filled and g.bull == bear and not usedFvg.includes(bear ? g.bar : -g.bar) and f_drOk(f_gapEntry(g, bear), bear, drEq)
                    float ce = (g.top + g.bottom) / 2
                    if not iPD or (bear ? ce <= eq : ce >= eq)
                        if na(best) or (bear ? g.top > best.top : g.bottom < best.bottom)
                            best := g
        if na(best)
            best := f_best5(bear, lg.extremeBar, eq, true, dispEnd, lg.z5.mss ? lg.z5.xt : 0, drEq)
        if na(best)
            best := f_noFvg(bear, farBar, lg.mssLevel, eq)
        if na(best)
            f_note(lg, bear, "MSS" + (lg.z5.mss ? " " + iLtfTf + "m" : "") + " ✓ · FVG in " + (bear ? "discount" : "premium") + " ✕ (waiting)")
        else if winNow == ""
            f_note(lg, bear, "MSS ✓ · FVG ✓ · killzone / silver bullet ✕")
        if na(best) or winNow == ""
            go := false
        if go
            lg.done := true
            f_useGap(best, bear)
            out := f_signal(lg, best, winNow, drHi, drHiB, drLo, drLoB)
    out

f_signalCont(Leg lg, Gap g, string win, float stopRef, float mainPx, string setupName, float drHi, int drHiB, float drLo, int drLoB) =>
    bool isSb = setupName == "silver_bullet"
    bool buy = not lg.bear
    string side = buy ? "buy" : "sell"
    string rej = ""
    float entry = iEdge == "Proximal" ? (buy ? g.top : g.bottom) : (g.top + g.bottom) / 2
    bool market = false
    if (buy ? close <= entry : close >= entry) or (iMktEntry and not iOnRetrace)
        entry := close
        market := true
    float sRef = na(stopRef) ? lg.one : stopRef
    // hunt setup entered on the lower timeframe: targets on the LTF leg (hunt extreme -> LTF swing it broke), like the zone setup
    bool ltf = not isSb and lg.c5.mss
    float lz = ltf ? lg.c5.zero : lg.zero
    float l1 = ltf ? sRef : lg.one
    float drEq = (drHi + drLo) / 2
    if (useDR or (iMktEntry and not iOnRetrace)) and (buy ? entry >= drEq : entry <= drEq)
        rej := "entry in " + (buy ? "premium" : "discount") + " of the dealing range (50% = " + f_num(drEq) + ")"
    if rej == ""
        rej := f_htfRej(buy, entry)
    if rej == "" and not TFOK
        rej := "chart is " + timeframe.period + "m - signals only on 15m (setting)"
    float stop = buy ? sRef - iSlPips * PIP : sRef + iSlPips * PIP
    if rej == "" and iOneSwing and usedStops.includes(math.round(stop / PIP * 10) * (buy ? 1 : -1))
        rej := "this stop-hunt swing already gave a trade (one trade per swing)"
    float risk = buy ? entry - stop : stop - entry
    float main = na
    float partial = lz - iPart * (l1 - lz)
    partial := buy ? partial - iTpBuf * PIP : partial + iTpBuf * PIP
    float rr = 0.0
    string tpWhy = ""
    if risk <= 0
        rej := "invalid risk"
    else if iUseMinStop and risk < iMinStop * PIP
        rej := "stop too tight (" + str.tostring(risk / PIP, "0.0") + " pips)"
    if rej == ""
        // silver bullet keeps its -2 (the move goes on); the hunt setup takes the first SDP zone of the hunt leg in premium / discount
        [m0, w0] = f_mainTarget(buy, entry, risk, lz, l1, isSb ? na : drEq, na(mainPx) ? lz - iTgt * (l1 - lz) : mainPx, "-" + str.tostring(isSb ? iZ2a : iTgt))
        main := m0
        tpWhy := w0
        if buy ? main <= entry : main >= entry
            rej := "target not beyond entry"
        if not (buy ? (entry < partial and partial < main) : (main < partial and partial < entry))
            partial := na
        rr := (buy ? main - entry : entry - main) / risk
        if rej == "" and iMinRR > 0 and rr < iMinRR
            rej := "R:R 1:" + str.tostring(rr, "0.0") + " below the minimum 1:" + str.tostring(iMinRR, "0.0") + tpWhy
    string warn = ""
    if rej == "" and MOF and not na(midOpen) and (buy ? entry >= midOpen : entry <= midOpen)
        if iMOHard
            rej := "entry " + (buy ? "above" : "below") + " NY Open " + f_num(midOpen)
        else
            warn += "wrong side of NY Open; "
    string eqLeft = ""
    if rej == "" and iUB
        float farPx = buy ? stop - iUBPips * PIP : stop + iUBPips * PIP
        string eqName = buy ? "Equal Lows" : "Equal Highs"
        for l in levels
            bool near = l.bsl != buy and (buy ? l.price >= farPx and l.price <= entry : l.price <= farPx and l.price >= entry)
            if near and (l.kind == "session" or l.kind == "day" or l.kind == "week") and warn == ""
                if STRICT
                    rej := "unfinished business: " + l.name + " " + f_num(l.price) + " not taken"
                    break
                else
                    warn += "unfinished business: " + l.name + " " + f_num(l.price) + "; "
            if near and l.name == eqName and eqLeft == ""
                eqLeft := l.name + " " + f_num(l.price)
        if rej == "" and eqLeft != "" and iUBEq and STRICT
            rej := "unfinished business: " + eqLeft + " not taken"
    if rej == "" and iHtfReq and htfTrend != (buy ? 1 : -1)
        rej := "against higher timeframe"
    if rej == ""
        string nws = iUseNews ? f_newsAt(time_close) : ""
        if nws != ""
            rej := "news: " + nws
    bool emitted = false
    if rej != ""
        st.rejected += 1
        if iShowRej
            f_grayNote(buy, (isSb ? "silver bullet setup: " : "hunt setup: ") + rej)
    else
        bool htfOk = iUseHTF and htfTrend == (buy ? 1 : -1)
        bool sbOk = iUseSB and inSB
        int maxScore = (iUseSB ? 1 : 0) + (iUseHTF ? 1 : 0)
        int score = (htfOk ? 1 : 0) + (sbOk ? 1 : 0)
        string grade = score >= 2 ? "A+" : score == 1 ? "A" : "B"
        if eqLeft != "" or warn != ""
            grade := "B"
        emitted := true
        lg.signaled := true
        st.dayCount += 1
        st.signals += 1
        string id = TK + "-" + timeframe.period + "-" + side + "-" + str.format_time(time_close, "yyyyMMddHHmm", "UTC")
        Trade trNew = Trade.new(id, not buy, entry, stop, partial, main, bar_index + validBars, market, legBar = lg.oneBar)
        trNew.warn := f_warn(buy, entry)
        trades.push(trNew)
        usedStops.push(math.round(stop / PIP * 10) * (buy ? 1 : -1))
        if usedStops.size() > 50
            usedStops.shift()
        st.liveLeg := lg.oneBar
        string zoneTxt = isSb ? "-1/-1.5 silver bullet" : buy ? "hunt leg discount" : "hunt leg premium"
        string ltfTxt = ltf ? " · MSS " + iLtfTf + "m" : ""
        if iShowTrade
            color col = buy ? cBuy : cSell
            int x2 = bar_index + iLineBars
            f_tradeLines(trNew, DRAW or not iOldSig, tpWhy)
            f_drawDR(trNew, drHi, drHiB, drLo, drLoB, buy)
            f_drawFvg(g, buy)
            f_sigSdp(l1, lz, ltf ? f_bar5(lg.c5.xi, lg.oneBar) : lg.oneBar, ltf ? lg.c5.zeroBar : lg.zeroBar, DRAW, col, isSb ? "SDP" : ltf ? "entry leg " + iLtfTf + "m" : "hunt leg")
            string txt = (buy ? "BUY " : "SELL ") + grade + " (" + str.tostring(score) + "/" + str.tostring(maxScore) + ")" + (isSb ? "\nSilver bullet -1/-1.5 (with the move)\n" : "\nReversal at prev. leg zone: hunt + MSS" + ltfTxt + "\n") + "Entry " + f_num(entry) + "\nSL " + f_num(stop) + "\nTP " + f_num(main) + tpWhy + "\nR:R 1:" + str.tostring(rr, "0.0") + "\nDealing range " + f_num(drLo) + " - " + f_num(drHi) + " · 50% " + f_num(drEq) + "\nDaily bias: " + f_dBiasTxt(buy) + "\n" + f_htfTxt(buy, entry) + "\n" + f_dFvgTxt(buy)
            float aB = na(atr14) ? 0.0 : atr14
            string shortTxt = (buy ? "BUY " : "SELL ") + grade + (ltf ? " · " + iLtfTf + "m" : "") + " · R:R 1:" + str.tostring(rr, "0.0") + "\nEntry " + f_num(entry) + (market ? " (mkt)" : "") + "\nSL " + f_num(stop) + "  TP " + f_num(main)
            txt := (trNew.warn == "" ? "" : trNew.warn + "\n") + txt
            shortTxt := (trNew.warn == "" ? "" : "⚠ REDUCE SIZE\n") + shortTxt
            trNew.tip := txt
            if DRAW or not iOldSig
                label lb = label.new(bar_index, buy ? math.min(rngLo, stop) - aB : math.max(rngHi, stop) + aB, (iOnRetrace ? "⏳ waiting for the FVG\n" : "") + (iCompact ? shortTxt : txt), style = buy ? label.style_label_up : label.style_label_down, color = col, textcolor = color.white, size = sSig, tooltip = txt)
                trNew.lab := lb
            else
                trNew.mini := true
                trNew.kind := isSb ? "SB" : ltf ? "hunt " + iLtfTf + "m" : "hunt"
                trNew.lab := label.new(bar_index, buy ? low - 0.3 * aB : high + 0.3 * aB, (buy ? "▲ " : "▼ ") + (trNew.warn == "" ? "" : "⚠") + trNew.kind, style = buy ? label.style_label_up : label.style_label_down, color = color.new(color.black, 100), textcolor = color.new(col, 10), size = sSig, tooltip = txt)
        if f_gradeRank(grade) >= f_gradeRank(iMinGrade) and not ALJSON and not iOnRetrace
            alert(f_sigTxt(buy, grade, (isSb ? "silver bullet -1/-1.5" : "stop-hunt leg (hunt + MSS)" + ltfTxt), entry, market, stop, partial, main, rr, validBars) + (trNew.warn == "" ? "" : "\n" + trNew.warn), alert.freq_once_per_bar_close)
        if f_gradeRank(grade) >= f_gradeRank(iMinGrade) and ALJSON
            string names = ""
            for nm in str.split(lg.names, ",")
                names += (names == "" ? "" : ",") + f_q(nm)
            string tg = "[{\"sd\":-1,\"price\":" + f_num(lz - 1.0 * (l1 - lz)) + "},{\"sd\":-1.5,\"price\":" + f_num(lz - 1.5 * (l1 - lz)) + "},{\"sd\":-2,\"price\":" + f_num(lz - 2.0 * (l1 - lz)) + "},{\"sd\":-2.5,\"price\":" + f_num(lz - 2.5 * (l1 - lz)) + "}]"
            string cf = "{\"daily_bias\":" + f_q(f_dBiasTxt(buy)) + ",\"htf_ranges\":" + f_q(f_htfTxt(buy, entry)) + ",\"daily_fvg\":" + f_q(f_dFvgTxt(buy)) + ",\"htf\":" + f_b(htfOk) + (iUseSB ? ",\"silver_bullet\":" + f_b(inSB) : "") + (eqLeft != "" ? ",\"unfinished_eq\":" + f_q(eqLeft) : "") + (warn != "" ? ",\"warnings\":[" + f_q(warn) + "]" : "") + "}"
            string js = "{\"passphrase\":" + f_q(iPass) + ",\"type\":\"signal\",\"setup\":" + f_q(setupName) + ",\"id\":" + f_q(id) + ",\"symbol\":" + f_q(TK) + ",\"exchange\":" + f_q(syminfo.prefix) + ",\"timeframe\":" + f_q(timeframe.period) + ",\"side\":" + f_q(side) + ",\"time\":" + f_q(str.format_time(time_close, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC")) + ",\"killzone\":" + f_q(win) + ",\"entry\":" + f_num(entry) + ",\"stop\":" + f_num(stop) + ",\"entry_type\":" + f_q(market ? "market" : "limit") + ",\"targets\":" + tg + ",\"main_target\":" + f_num(main) + ",\"partial_target\":" + f_num(partial) + ",\"rr\":" + str.tostring(rr, "0.00") + ",\"zone\":" + f_q(zoneTxt) + ",\"sdp_one\":" + f_num(lg.one) + ",\"sdp_zero\":" + f_num(lg.zero) + ",\"leg_one\":" + f_num(l1) + ",\"leg_zero\":" + f_num(lz) + ",\"mss_level\":" + f_num(isSb ? lg.sbLvl : ltf ? lg.c5.zero : lg.cLevel) + ",\"mss_tf\":" + f_q(ltf ? iLtfTf : timeframe.period) + ",\"fvg_top\":" + f_num(g.top) + ",\"fvg_bottom\":" + f_num(g.bottom) + ",\"swept\":[" + names + "],\"midnight_open\":" + f_num(midOpen) + ",\"dr_high\":" + f_num(drHi) + ",\"dr_low\":" + f_num(drLo) + ",\"dr_eq\":" + f_num(drEq) + ",\"confirmations\":" + cf + ",\"score\":" + str.tostring(score) + ",\"max_score\":" + str.tostring(maxScore) + ",\"grade\":" + f_q(grade) + "}"
            alert(js, alert.freq_once_per_bar_close)
    emitted

f_stepCont(Leg lg) =>
    bool out = false
    bool buy = not lg.bear
    bool go = iHunt and not lg.cDone
    if go and (buy ? close < lg.one : close > lg.one)
        lg.cDone := true
        go := false
    if go
        lg.cFar := na(lg.cFar) ? (buy ? high : low) : buy ? math.max(lg.cFar, high) : math.min(lg.cFar, low)
        if buy ? lg.cFar >= f_fib(lg, -iPart) : lg.cFar <= f_fib(lg, -iPart)
            lg.cDone := true
            go := false
    if go
        if not lg.cMss
            bool noted = false
            if na(lg.cLevel)
                float pI = na
                array<int> pb = buy ? ithB : itlB
                array<float> pp = buy ? ithP : itlP
                int nI = pb.size()
                if nI > 0
                    for k = nI - 1 to math.max(0, nI - 60)
                        int b = pb.get(k)
                        float pk = pp.get(k)
                        if b < lg.oneBar and b >= lg.oneBar - iIthLB and b > lg.cLvlBar and (buy ? pk >= lg.zero : pk <= lg.zero)
                            pI := pk
                            lg.cLvlBar := b
                lg.cLevel := na(pI) ? lg.zero : pI
                if na(pI)
                    lg.cLvlBar := lg.zeroBar
            if buy ? high > lg.cLevel : low < lg.cLevel
                if not lg.cMssDrawn
                    lg.cMssDrawn := true
                    f_drawMss(lg.cLvlBar, lg.cLevel, "MSS")
                bool disp = not iDisp
                int ob = bar_index - lg.oneBar
                if not disp and ob >= 1
                    for k = 0 to ob - (iDispHunt ? 0 : 1)
                        float rng = high[k] - low[k]
                        float body = buy ? close[k] - open[k] : open[k] - close[k]
                        if rng > 0 and body >= 0.5 * rng and (na(atr14[k]) or rng >= iDispAtr * atr14[k])
                            disp := true
                            break
                if disp
                    lg.cMss := true
                    lg.cMssBar := bar_index
                else
                    noted := true
                    f_note(lg, buy, "MSS without displacement (candle >= " + str.tostring(iDispAtr) + " ATR) - no signal yet")
            // no MSS on the chart: the lower timeframe - break of the LTF swing before the hunt extreme (the hunt is the stop hunt)
            if not lg.cMss and LTF_MSS
                if f_track5(lg.c5, buy, lg.oneBar, false, lg.oneBar)
                    if not iDisp or f_disp5(buy, lg.c5.xi)
                        lg.cMss := true
                        lg.cMssBar := bar_index
                        lg.c5.mss := true
                        f_drawMss(lg.c5.zeroBar, lg.c5.zero, "MSS " + iLtfTf + "m")
                    else if not noted
                        f_note(lg, buy, "MSS " + iLtfTf + "m without displacement (candle >= " + str.tostring(iDispAtr) + " ATR) - no signal yet")
            go := lg.cMss
    if go
        // MSS from the lower timeframe: its extreme is the hunt (a wick past fib 1 that did not close there counts)
        bool ltf = lg.c5.mss
        float hl = ltf and not na(lg.c5.xp) ? (buy ? math.min(lg.one, lg.c5.xp) : math.max(lg.one, lg.c5.xp)) : lg.one
        int hlB = ltf ? f_bar5(lg.c5.xi, lg.oneBar) : lg.oneBar
        float eq = (hl + lg.cFar) / 2
        int oxc = bar_index - lg.oneBar
        float farC = buy ? high : low
        int farCBar = bar_index
        for k = 0 to oxc
            if buy ? high[k] >= farC : low[k] <= farC
                farC := buy ? high[k] : low[k]
                farCBar := bar_index - k
        int dispEndC = iFvgDisp ? farCBar : bar_index
        // dealing range: SSL = the hunt (buy), BSL = the last opposite stop hunt beyond it, else fib 0; wider if price went past it
        f_oppHunt(lg)
        float base = na(lg.oppPx) ? lg.zero : lg.oppPx
        int baseB = na(lg.oppPx) ? lg.zeroBar : lg.oppBar
        bool farOut = buy ? farC > base : farC < base
        float drHi = buy ? (farOut ? farC : base) : hl
        int drHiB = buy ? (farOut ? farCBar : baseB) : hlB
        float drLo = buy ? hl : (farOut ? farC : base)
        int drLoB = buy ? hlB : (farOut ? farCBar : baseB)
        float drEq = (drHi + drLo) / 2
        float eqD = useDR ? (buy ? math.min(eq, drEq) : math.max(eq, drEq)) : eq
        Gap best = lg.cMssBar == bar_index ? f_mssMkt(buy, eqD) : na
        int gs = na(best) ? gaps.size() : 0
        if gs > 0
            for idx = math.max(0, gs - 60) to gs - 1
                Gap g = gaps.get(idx)
                if g.bar - (iDispHunt ? 1 : 2) >= hlB and g.bar < bar_index and g.bar <= dispEndC and not g.filled and g.bull == buy and not usedFvg.includes(buy ? g.bar : -g.bar) and f_drOk(f_gapEntry(g, buy), buy, drEq)
                    if not iPD or (buy ? g.bottom <= eq : g.top >= eq)
                        if na(best) or (buy ? g.top > best.top : g.bottom < best.bottom)
                            best := g
        if na(best)
            best := f_best5(buy, ltf ? hlB : lg.oneBar + 1, eq, false, dispEndC, ltf ? lg.c5.xt : 0, drEq)
        if na(best)
            best := f_noFvg(buy, farCBar, ltf ? lg.c5.zero : lg.cLevel, eqD)
        if na(best)
            f_note(lg, buy, "MSS" + (ltf ? " " + iLtfTf + "m" : "") + " ✓ · FVG in " + (buy ? "discount" : "premium") + " ✕ (waiting)")
        else if winNow == ""
            f_note(lg, buy, "MSS ✓ · FVG ✓ · killzone / silver bullet ✕")
        if na(best) or winNow == ""
            go := false
        if go and MOF and (STRICT or iMOHard) and not na(midOpen)
            float ent = iEdge == "Proximal" ? (buy ? best.top : best.bottom) : (best.top + best.bottom) / 2
            if (buy ? close <= ent : close >= ent) or (iMktEntry and not iOnRetrace)
                ent := close
            if buy ? ent >= midOpen : ent <= midOpen
                go := false
                f_note(lg, buy, "MSS ✓ · FVG ✓ · entry " + (buy ? "below" : "above") + " NY Open ✕ (waiting)")
        if go
            array<Leg> oppBook = buy ? bearLegs : bullLegs
            for x in (lg.inZone ? array.new<Leg>() : oppBook)  // a hunt at a reversal zone is not "against"
                if AGL >= 0 and not x.done and x.oneBar < lg.oneBar and (buy ? lg.one < x.zero and lg.one > f_lvl(x, AGL > 0 ? AGL : iZ2a) : lg.one > x.zero and lg.one < f_lvl(x, AGL > 0 ? AGL : iZ2a))
                    lg.cDone := true
                    go := false
                    st.rejected += 1
                    if iShowRej
                        f_grayNote(buy, "hunt setup against the live " + (buy ? "bearish" : "bullish") + " SDP (inside its 0..-2)")
                    break
        if go
            lg.cDone := true
            f_useGap(best, buy)
            out := f_signalCont(lg, best, winNow, ltf ? hl : na, na, "continuation", drHi, drHiB, drLo, drLoB)
    out

f_stepSb(Leg lg) =>
    bool out = false
    bool buy = not lg.bear
    if iSbEntry and not lg.sbDone and not lg.done and not lg.fs and lg.zone == ""
        float onePx = f_fib(lg, -iZ1a)
        float twoPx = f_fib(lg, -iZ2a)
        float farNow = buy ? high : low
        float back = buy ? low : high
        if buy ? farNow >= twoPx : farNow <= twoPx
            lg.sbDone := true
        else if lg.sbTouch < 0
            if buy ? farNow >= onePx : farNow <= onePx
                lg.sbTouch := bar_index
        else if buy ? back < lg.zero : back > lg.zero
            lg.sbDone := true
        else if na(lg.sbExt) or (buy ? back < lg.sbExt : back > lg.sbExt)
            lg.sbExt := back
            lg.sbExtBar := bar_index
            lg.sbMss := false
        else
            if not lg.sbMss
                array<int> pb = buy ? shB : slB
                array<float> pp = buy ? shP : slP
                int bI = -1
                float pI = na
                int n = pb.size()
                if n > 0
                    for k = n - 1 to 0
                        int b = pb.get(k)
                        if b < lg.sbExtBar
                            if b >= lg.sbTouch - iIthLB
                                bI := b
                                pI := pp.get(k)
                            break
                if bI >= 0 and (buy ? high > pI : low < pI)
                    bool disp = not iDisp
                    int ob = bar_index - lg.sbExtBar
                    if not disp and ob >= 1
                        for k = 0 to ob - 1
                            float rng = high[k] - low[k]
                            float body = buy ? close[k] - open[k] : open[k] - close[k]
                            if rng > 0 and body >= 0.5 * rng and (na(atr14[k]) or rng >= iDispAtr * atr14[k])
                                disp := true
                                break
                    if disp
                        lg.sbMss := true
                        lg.sbLvl := pI
                        f_drawMss(bI, pI, "MSS")
            if lg.sbMss and inSB
                int ox = bar_index - lg.sbExtBar
                float far = buy ? high : low
                for k = 0 to ox
                    far := buy ? math.max(far, high[k]) : math.min(far, low[k])
                float eq = (lg.sbExt + far) / 2
                // dealing range: the pullback extreme to the top (buy) / bottom (sell) of the move since the hunt
                float rTop = buy ? high : low
                int rTopB = bar_index
                for k = 0 to bar_index - lg.oneBar
                    if buy ? high[k] > rTop : low[k] < rTop
                        rTop := buy ? high[k] : low[k]
                        rTopB := bar_index - k
                float drHi = buy ? rTop : lg.sbExt
                int drHiB = buy ? rTopB : lg.sbExtBar
                float drLo = buy ? lg.sbExt : rTop
                int drLoB = buy ? lg.sbExtBar : rTopB
                float drEq = (drHi + drLo) / 2
                Gap best = na
                int gs = gaps.size()
                if gs > 0
                    for idx = math.max(0, gs - 60) to gs - 1
                        Gap g = gaps.get(idx)
                        if g.bar - 2 >= lg.sbExtBar and g.bar <= bar_index and not g.filled and g.bull == buy and not usedFvg.includes(buy ? g.bar : -g.bar) and f_drOk(f_gapEntry(g, buy), buy, drEq)
                            float ce = (g.top + g.bottom) / 2
                            if not iPD or (buy ? ce <= eq : ce >= eq)
                                if na(best) or (buy ? g.top > best.top : g.bottom < best.bottom)
                                    best := g
                if not na(best)
                    lg.sbDone := true
                    usedFvg.push(buy ? best.bar : -best.bar)
                    if usedFvg.size() > 100
                        usedFvg.shift()
                    out := f_signalCont(lg, best, winNow == "" ? "silver_bullet" : winNow, lg.sbExt, twoPx, "silver_bullet", drHi, drHiB, drLo, drLoB)
    out

f_stepBook(array<Leg> book) =>
    bool fired = false
    bool firedC = false
    int n = book.size()
    if n > 0
        for k = 0 to n - 1
            Leg lg = book.get(k)
            if not lg.done and lg.createdBar != bar_index
                bool orphan = false
                if lg.fs
                    orphan := true
                    for x in book
                        if x.oneBar == lg.parentBar and not x.fs and not x.done
                            orphan := false
                if bar_index - lg.oneBar > iLegAge or orphan
                    lg.done := true
                    lg.endWhy := orphan ? "main leg ended" : "zone not reached (expired)"
                if not lg.mssOk and (lg.bear ? low < lg.zero : high > lg.zero)
                    lg.mssOk := true
                bool swingAfter = lg.bear ? (slB.size() > 0 and slB.last() > lg.oneBar) : (shB.size() > 0 and shB.last() > lg.oneBar)
                if not lg.done and lg.zone == "" and not lg.cMss and not lg.fs and not lg.hasFs and not swingAfter
                    bool deeper = lg.bear ? high > lg.one and close <= lg.one : low < lg.one and close >= lg.one
                    if deeper
                        lg.one := lg.bear ? high : low
                        lg.oneBar := bar_index
                        lg.drOne := lg.one
                        lg.redraw := true
                else
                    bool fsOnly = lg.hasFs and not lg.fs and iFsOnly != "Off"
                    bool fsAll = fsOnly and iFsOnly == "Every setup of the main leg"
                    if not firedC and iHunt and not lg.cDone and not fsAll
                        firedC := f_stepCont(lg)
                    if not firedC and iSbEntry and not lg.sbDone and not fsAll
                        firedC := f_stepSb(lg)
                    if not fired and not lg.done and not fsOnly
                        fired := f_stepLeg(lg)
    fired

var array<Leg> histLegs = array.new<Leg>()
f_freezeLeg(Leg lg) =>
    int x2 = math.min(bar_index, f_fibEnd(lg))
    if not iFibTv
        for ln in lg.lns
            line.set_x2(ln, x2)
        if not iFibLeft
            for lb in lg.lbs
                label.set_x(lb, x2)
        for bx in lg.bxs
            box.set_right(bx, x2)
    x2

f_hide(Leg lg) =>
    for ln in lg.lns
        line.delete(ln)
    for lb in lg.lbs
        label.delete(lb)
    for bx in lg.bxs
        box.delete(bx)
    lg.lns.clear()
    lg.lbs.clear()
    lg.bxs.clear()
    lg.lns.size()

f_primary(array<Leg> book) =>
    int best = -1
    int bestPri = -1
    int n = book.size()
    if n > 0
        for k = 0 to n - 1
            Leg lg = book.get(k)
            if not lg.done and (lg.mssOk or not iMssDraw) and (st.liveLeg < 0 or lg.oneBar == st.liveLeg)
                int pri = lg.zone != "" or (lg.cMss and not lg.cDone) ? 2 : lg.fs ? 0 : 1
                if pri >= bestPri
                    best := k
                    bestPri := pri
    best

f_upkeep(array<Leg> book) =>
    int prim = iClean ? f_primary(book) : -1
    int n = book.size()
    if n > 0
        for k = n - 1 to 0
            Leg lg = book.get(k)
            if lg.redraw
                lg.redraw := false
                f_hide(lg)
                if not iClean
                    f_drawLeg(lg)
            if not lg.done
                if not iClean
                    f_extendLeg(lg)
                else if k == prim or lg.signaled
                    if lg.lns.size() == 0
                        f_drawLeg(lg)
                    else
                        f_extendLeg(lg)
                else if lg.lns.size() > 0
                    f_hide(lg)
            if lg.done
                if not lg.cleaned
                    bool keep = lg.signaled ? iHist != "Live legs only" : not iClean and iHist == "All legs" and lg.endWhy != "replaced by the last stop hunt"
                    if keep and iClean and lg.lns.size() == 0
                        f_drawLeg(lg)
                    if keep and lg.lns.size() > 0
                        f_freezeLeg(lg)
                        if not lg.signaled and lg.endWhy != ""
                            lg.lbs.push(label.new(math.min(bar_index, f_fibEnd(lg)), f_fib(lg, 0.0), "SDP ended: " + lg.endWhy, style = label.style_label_left, color = color.new(color.black, 100), textcolor = color.gray, size = size.tiny))
                        histLegs.push(lg)
                        while histLegs.size() > iHistN
                            f_deleteLeg(histLegs.shift())
                    else
                        f_deleteLeg(lg)
                book.remove(k)
    book.size()

f_stepBook(bearLegs)
f_stepBook(bullLegs)
f_upkeep(bearLegs)
f_upkeep(bullLegs)

var table dash = table.new(position.top_right, 2, 11, bgcolor = color.new(color.black, 20), border_color = color.new(color.gray, 60), border_width = 1)
f_row(int r, string k, string v, color col) =>
    table.cell(dash, 0, r, k, text_color = color.silver, text_size = sDash, text_halign = text.align_left)
    table.cell(dash, 1, r, v, text_color = col, text_size = sDash, text_halign = text.align_right)
    r
f_contTxt(array<Leg> book) =>
    string t = ""
    if iHunt
        for lg in book
            if not lg.done and not lg.cDone and lg.cMss
                t := "hunt MSS" + (lg.c5.mss ? " " + iLtfTf + "m" : "") + " ✓, wait retrace to FVG"
    t
f_bookTxt(array<Leg> book) =>
    string t = "—"
    int live = 0
    string best = ""
    for lg in book
        if not lg.done
            live += 1
            if lg.zone != ""
                best := lg.mssBar < 0 ? "at zone " + lg.zone + ", wait MSS" + (LTF_MSS ? " (" + timeframe.period + "m / " + iLtfTf + "m)" : "") : "MSS" + (lg.z5.mss ? " " + iLtfTf + "m" : "") + " ✓, wait FVG"
    if live > 0
        t := best != "" ? best : str.tostring(live) + (live == 1 ? " leg" : " legs") + ", waiting zone"
    t
if iShowDash and barstate.islast
    string nNow = f_newsAt(time_close)
    f_row(0, "MZ SDP", TK + " · " + timeframe.period + (timeframe.period != "15" ? "  ⚠ built for 15m" : ""), timeframe.period != "15" ? color.orange : color.white)
    string cBuyTxt = f_contTxt(bullLegs)
    string cSellTxt = f_contTxt(bearLegs)
    f_row(1, "Buy setup", cBuyTxt != "" ? cBuyTxt : f_bookTxt(bearLegs), cBuy)
    f_row(2, "Sell setup", cSellTxt != "" ? cSellTxt : f_bookTxt(bullLegs), cSell)
    f_row(3, "NY Open", na(midOpen) ? "—" : f_num(midOpen) + (not MOF ? " (filter off)" : close > midOpen ? "  above → sells" : "  below → buys"), color.white)
    f_row(4, "Window", winNow == "" ? "— (outside killzones)" : winNow, winNow == "" ? color.gray : color.yellow)
    f_row(5, "HTF", htfTrend == 1 ? "Bullish" : htfTrend == -1 ? "Bearish" : "Neutral", htfTrend == 1 ? cBuy : htfTrend == -1 ? cSell : color.gray)
    f_row(9, "Daily", (dBias == 1 ? "Bullish" : dBias == -1 ? "Bearish" : "Neutral") + " · trend " + (dTrend == 1 ? "up" : dTrend == -1 ? "down" : "—") + (not na(dBB) and close >= dBB and close <= dBT ? " · in bull D-FVG" : not na(dSB) and close >= dSB and close <= dST ? " · in bear D-FVG" : ""), dBias == 1 ? cBuy : dBias == -1 ? cSell : color.gray)
    f_row(6, "News", nNow == "" ? "clear" : "⛔ " + nNow, nNow == "" ? cBuy : cSell)
    f_row(7, "Signals today", str.tostring(st.dayCount), color.white)
    string wr = st.closed > 0 ? str.tostring(100.0 * st.wins / st.closed, "0") + "%" : "—"
    f_row(8, "Closed / Win / ΣR", str.tostring(st.closed) + " / " + wr + " / " + str.tostring(st.totalR, "0.0") + "R", st.totalR >= 0 ? cBuy : cSell)
    Trade trLast = trades.size() > 0 ? trades.last() : na
    if not na(trLast) and trLast.state <= 1
        string wFa = str.replace_all(str.replace_all(str.replace_all(str.replace_all(str.replace_all(trLast.warn, "⚠ ", "⚠️ "), "against daily trend", "خلاف روند دیلی"), "against daily bias", "خلاف بایاس دیلی"), "wrong side of 4h range", "سمت اشتباه رنج ۴ ساعته"), " → reduce size", " — با حجم کمتر")
        f_row(10, (trLast.sell ? "SELL " : "BUY ") + (trLast.state == 0 ? "pending" : "open"), trLast.warn == "" ? "✅ حجم عادی" : wFa, trLast.warn == "" ? cBuy : color.orange)
    else
        f_row(10, "Size", "— (no open signal)", color.gray)

