if barstate.isfirst and iFomc
    for d in array.from("2025-01-29", "2025-03-19", "2025-05-07", "2025-06-18", "2025-07-30", "2025-09-17", "2025-10-29", "2025-12-10", "2026-01-28", "2026-03-18", "2026-04-29", "2026-06-17", "2026-07-29", "2026-09-16", "2026-10-28", "2026-12-09")
        int fy = int(str.tonumber(str.substring(d, 0, 4)))
        int fm = int(str.tonumber(str.substring(d, 5, 7)))
        int fd = int(str.tonumber(str.substring(d, 8, 10)))
        int ft = timestamp(TZ, fy, fm, fd, 14, 0)
        newsTimes.push(ft)
        newsFrom.push(iNewsDay ? timestamp(TZ, fy, fm, fd, 0, 0) : ft - iNewsBefore * 60000)
        newsTo.push(ft + math.max(iNewsAfter, iMajorAfter) * 60000)

if barstate.isfirst and iNewsOn and str.length(iNewsList) > 0
    array<string> rows = str.split(str.replace_all(iNewsList, ",", "\n"), "\n")
    for r in rows
        string s = str.match(r, "[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}")
        if str.length(s) == 16
            int y = int(str.tonumber(str.substring(s, 0, 4)))
            int mo = int(str.tonumber(str.substring(s, 5, 7)))
            int d = int(str.tonumber(str.substring(s, 8, 10)))
            int hh = int(str.tonumber(str.substring(s, 11, 13)))
            int mi = int(str.tonumber(str.substring(s, 14, 16)))
            if not na(y) and not na(mo) and not na(d) and not na(hh) and not na(mi)
                int nt = timestamp(TZ, y, mo, d, hh, mi)
                string up = str.upper(r)
                bool major = str.contains(up, "CPI") or str.contains(up, "NFP") or str.contains(up, "NON-FARM") or str.contains(up, "FOMC") or str.contains(up, "RATE")
                int fromT = nt - iNewsBefore * 60000
                int toT = nt + (major ? math.max(iNewsAfter, iMajorAfter) : iNewsAfter) * 60000
                if major and iNewsDay
                    fromT := math.min(fromT, timestamp(TZ, y, mo, d, 0, 0))
                newsTimes.push(nt)
                newsFrom.push(fromT)
                newsTo.push(toT)

f_newsAt(int t) =>
    string r = ""
    if newsTimes.size() > 0
        for i = 0 to newsTimes.size() - 1
            if t >= newsFrom.get(i) and t <= newsTo.get(i)
                r := "red news " + str.format_time(newsTimes.get(i), "yyyy-MM-dd HH:mm", TZ) + " NY"
                break
    r

f_removeLevels(string kind, string prefix) =>
    int n = levels.size()
    if n > 0
        for i = n - 1 to 0
            Level l = levels.get(i)
            if l.kind == kind and (prefix == "" or str.startswith(l.name, prefix))
                levels.remove(i)
    n

